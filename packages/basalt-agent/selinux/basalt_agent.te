policy_module(basalt_agent, 0.3.1)

# basalt-agent: AI coding agent command lines (Claude Code, Codex CLI,
# Gemini CLI, Aider, ...) confined by SELinux. Two domains:
#
# basalt_agent_t, native mode. Entered from the user's own (unconfined)
# launcher through the entry point basalt-agent-exec (basalt_agent_exec_t),
# with the session's MCS level. It may:
#   - read and change the project handed to it, and run what is there
#     (builds, tests), at its own level only (mcs_constrained);
#   - use its own home and temporary files; read and run system programs
#     and its installed tools;
#   - connect to the session proxy port (the proxy filters by name), and
#     listen on and reach TCP ports 1024 and up for local servers (which
#     addresses: basalt-resolver's kernel filter); no UDP, no DNS, no
#     privileged port;
#   - use its terminal (without TIOCSTI).
# Everything else is denied and audited: the rest of the home (~/.ssh,
# ~/.gnupg, keyrings, browser profiles, other projects), other users'
# homes, the user's runtime sockets (session bus, keyring, the desktop
# shell's control socket), the system assistant's state, other sessions,
# signals or ptrace to processes outside the domain, setuid and
# capabilities (the helper also sets no_new_privs).
#
# basalt_agent_proxy_t, the per-session egress proxy. The only part of a
# session that resolves names and reaches the network, on the ports its
# allowlist names. It also holds the session's API keys (handed over on a
# pipe by the launcher) and adds them to requests for the provider host
# each key belongs to, over TLS it verifies against the system trust
# store. Agent domains cannot read, trace or signal it.

gen_require(`
	type unconfined_t;
	role unconfined_r;
	type basalt_agent_session_t, basalt_agent_proxy_port_t;
')

type basalt_agent_t;
type basalt_agent_exec_t;
application_domain(basalt_agent_t, basalt_agent_exec_t)
unconfined_run_to(basalt_agent_t, basalt_agent_exec_t)
mcs_constrained(basalt_agent_t)

type basalt_agent_proxy_t;
type basalt_agent_proxy_exec_t;
application_domain(basalt_agent_proxy_t, basalt_agent_proxy_exec_t)
unconfined_run_to(basalt_agent_proxy_t, basalt_agent_proxy_exec_t)

########################################
#
# basalt_agent_t
#

basalt_agent_domain_type(basalt_agent_t)
basalt_agent_exec_tools(basalt_agent_t)
basalt_agent_allow_jit(basalt_agent_t)
basalt_agent_manage_project(basalt_agent_t)
basalt_agent_manage_home(basalt_agent_t)
basalt_agent_use_terminals(basalt_agent_t)
basalt_agent_connect_proxy(basalt_agent_t)

# The launcher is the parent: inherited descriptors (pipes, the terminal)
# and the exit signal, nothing more (no signals, no ptrace, no /proc).
allow basalt_agent_t unconfined_t:fd use;
allow basalt_agent_t unconfined_t:fifo_file rw_inherited_fifo_file_perms;
allow basalt_agent_t unconfined_t:process sigchld;

# Direct egress (off by default): with basalt-resolver making every
# session default-deny in the kernel (nftables matched by the session's
# cgroup, sets filled only from DNS answers for allowlisted names), an
# agent may also connect without the proxy and resolve names itself (its
# DNS is redirected to its session resolver). The kernel filter is then
# the boundary for those connections; turn it on with
# setsebool -P basalt_agent_direct_egress on.
#
# Deliberately not granted: reading /etc/resolv.conf through /run/systemd
# (sysnet_read_config). Searching /run/systemd would also reach
# systemd-resolved's varlink socket, which every domain may connect to,
# and resolve any name outside the session resolver (a DNS exfiltration
# path). Without resolv.conf the C library and Go use 127.0.0.1:53, which
# the session rules redirect to the session resolver too.
gen_tunable(basalt_agent_direct_egress, false)
tunable_policy(`basalt_agent_direct_egress',`
	allow basalt_agent_t self:udp_socket create_socket_perms;
	allow basalt_agent_t self:tcp_socket create_stream_socket_perms;
	allow basalt_agent_t self:netlink_route_socket r_netlink_socket_perms;
	corenet_tcp_connect_all_ports(basalt_agent_t)
	kernel_read_network_state(basalt_agent_t)
	kernel_read_network_state_symlinks(basalt_agent_t)
	kernel_read_net_sysctls(basalt_agent_t)
')
# The resolver library still tries /etc/resolv.conf and /etc/hosts (host
# network configuration, net_conf_t); both stay unreadable, quietly, and
# it falls back to 127.0.0.1:53, the session resolver.
gen_require(`
	type net_conf_t;
')
dontaudit basalt_agent_t net_conf_t:file read_file_perms;
dontaudit basalt_agent_t net_conf_t:lnk_file read_lnk_file_perms;

# Node (libuv) probes io_uring and falls back to threads when refused;
# agents do not get io_uring (a large kernel attack surface), quietly.
optional_policy(`
	gen_require(`
		type io_uring_t;
	')
	dontaudit basalt_agent_t io_uring_t:anon_inode create;
')

# Runtimes read vm.mmap_min_addr at start (Bun, which Claude Code is
# built with); a read-only system setting.
kernel_read_vm_sysctls(basalt_agent_t)

# Local servers: an agent may listen on a TCP port 1024 and up and reach
# such ports: a dev server or a test server it started (Go's httptest,
# a web framework's dev server), a test database, and the local callback
# of a command line login (Claude Code's OAuth login listens on
# 127.0.0.1 for the browser's redirect; without this it failed with
# "permission denied 127.0.0.1:0"). Ports below 1024 stay closed. SELinux
# reasons about port types, not addresses: which addresses a session may
# reach is decided by basalt-resolver's kernel filter (loopback with the
# profile's loopback = yes, the default, and the allowlisted names on
# their ports; docs/network.md), and inbound connections from other hosts
# are refused by the firewall's default zone.
allow basalt_agent_t self:tcp_socket { listen accept };
corenet_tcp_bind_generic_node(basalt_agent_t)
corenet_tcp_bind_all_unreserved_ports(basalt_agent_t)
corenet_tcp_bind_all_ephemeral_ports(basalt_agent_t)
corenet_tcp_connect_all_unreserved_ports(basalt_agent_t)
corenet_tcp_connect_all_ephemeral_ports(basalt_agent_t)

# Probes that agents make and do not need, quietly refused: Claude Code
# (Bun) enumerates /dev, stats /proc/kcore, looks at /proc/sys/fs and the
# devpts root, and tries syslog's /dev/log.
dev_dontaudit_getattr_all_chr_files(basalt_agent_t)
dev_dontaudit_getattr_all_blk_files(basalt_agent_t)
kernel_dontaudit_getattr_core_if(basalt_agent_t)
kernel_dontaudit_search_fs_sysctl(basalt_agent_t)
term_dontaudit_search_ptys(basalt_agent_t)
gen_require(`
	type devlog_t;
')
dontaudit basalt_agent_t devlog_t:lnk_file read_lnk_file_perms;

# The helper checks its own context before running the agent.
allow basalt_agent_t self:process { getattr setexec };
# Programs re-execute themselves (node spawns node).
allow basalt_agent_t basalt_agent_exec_t:file read_file_perms;

########################################
#
# basalt_agent_proxy_t
#

allow basalt_agent_proxy_t self:process { getsched signal_perms };
allow basalt_agent_proxy_t self:fifo_file rw_fifo_file_perms;
allow basalt_agent_proxy_t self:unix_stream_socket create_stream_socket_perms;
allow basalt_agent_proxy_t self:unix_dgram_socket create_socket_perms;
allow basalt_agent_proxy_t self:tcp_socket { create_stream_socket_perms listen accept };
allow basalt_agent_proxy_t self:udp_socket create_socket_perms;
allow basalt_agent_proxy_t unconfined_t:fd use;
allow basalt_agent_proxy_t unconfined_t:fifo_file rw_inherited_fifo_file_perms;
allow basalt_agent_proxy_t unconfined_t:process sigchld;
userdom_use_user_terminals(basalt_agent_proxy_t)

kernel_read_system_state(basalt_agent_proxy_t)
kernel_read_net_sysctls(basalt_agent_proxy_t)
kernel_read_kernel_sysctls(basalt_agent_proxy_t)
dev_read_urand(basalt_agent_proxy_t)
dev_read_sysfs(basalt_agent_proxy_t)
fs_search_cgroup_dirs(basalt_agent_proxy_t)
fs_read_cgroup_files(basalt_agent_proxy_t)
files_read_etc_files(basalt_agent_proxy_t)
miscfiles_read_localization(basalt_agent_proxy_t)

# Listens on a loopback proxy port (native mode) or on a Unix socket in
# the session directory (container mode).
allow basalt_agent_proxy_t basalt_agent_proxy_port_t:tcp_socket name_bind;
corenet_tcp_bind_generic_node(basalt_agent_proxy_t)
userdom_search_user_tmp_dirs(basalt_agent_proxy_t)
allow basalt_agent_proxy_t basalt_agent_session_t:dir rw_dir_perms;
manage_sock_files_pattern(basalt_agent_proxy_t, basalt_agent_session_t, basalt_agent_session_t)

# Resolves names and connects to any TCP port: which address and port a
# session may reach is decided by the proxy's allowlist and enforced in
# the kernel by basalt-resolver (the proxy runs inside the session's
# filtered cgroup, whose sets hold only addresses that allowed names
# resolved to, each with the ports its entry allows). So a "private" entry
# on another port (a model server on 11434) works through the proxy, with
# direct egress off.
sysnet_dns_name_resolve(basalt_agent_proxy_t)
corenet_tcp_connect_all_ports(basalt_agent_proxy_t)

# TLS to the model providers (credential routes): the system trust store.
miscfiles_read_generic_certs(basalt_agent_proxy_t)

# The keys are in the proxy's memory: no agent domain may read its /proc
# entries (memory, environment, file descriptors), trace it or signal it.
# The proxy also makes itself non-dumpable, so the kernel refuses ptrace
# and /proc access from the user's other processes as well.
neverallow basalt_agent_domain basalt_agent_proxy_t:process { ptrace signal sigkill sigstop signull getattr };
neverallow basalt_agent_domain basalt_agent_proxy_t:{ file lnk_file } { open read getattr };
neverallow basalt_agent_domain basalt_agent_proxy_t:dir { open read search getattr };
# Container sessions run in another PID namespace and never see the proxy.

########################################
#
# Container mode: a session container (container_t at the session's
# level) reaches its proxy through the mounted Unix socket.
#

optional_policy(`
	gen_require(`
		type container_t;
	')
	allow container_t basalt_agent_proxy_t:unix_stream_socket connectto;
')

########################################
#
# The launcher (the user's unconfined session) prepares and labels.
#

basalt_agent_launcher(unconfined_t)
