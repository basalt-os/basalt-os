# Template for a new basalt-agent profile. Copy it to
# ~/.config/basalt-agent/profiles/NAME.conf (user) or
# /etc/basalt-agent/profiles/NAME.conf (system), set name = NAME, and keep
# the egress list as short as the agent allows.

[agent]
name = myagent
description = What the agent is
# Program looked up in PATH: the tool directory (native mode) or the image.
command = myagent
# Arguments always passed before the ones given on the command line.
#args =

[install]
# npm: npm install of package; pip: a virtual environment with package;
# none: the program is already in the image or on the system.
method = npm
package = example-agent-cli
# dnf packages for the container image and for native mode.
packages = nodejs npm git

[env]
# Plain settings. HOME, PATH, the proxy variables and loader variables are
# set by basalt-agent and cannot be changed here.
#EXAMPLE_TELEMETRY = off

[secrets]
# API keys read from ~/.config/basalt-agent/secrets/NAME.env (mode 0600)
# or the keyring, for one session. The agent never sees a key: it gets a
# placeholder in the variable, and the session proxy adds the real key only
# to requests for the host the key belongs to. Keys with a built-in route
# (ANTHROPIC_API_KEY, ANTHROPIC_AUTH_TOKEN, OPENAI_API_KEY, GEMINI_API_KEY,
# GOOGLE_API_KEY, OPENROUTER_API_KEY) need nothing more; any other key
# needs a route, or it is not used:
#   route = NAME HOST[:PORT] header=HEADER [scheme=Bearer] [base_env=VAR] [base_path=/v1]
# base_env names the variable that points the agent at http://HOST[base_path];
# the proxy sends those requests to https://HOST:PORT with the key. HOST
# must be on the egress list at PORT (default 443).
env = EXAMPLE_API_KEY
route = EXAMPLE_API_KEY api.example.com header=Authorization scheme=Bearer base_env=EXAMPLE_BASE_URL

[egress]
# Names the agent may reach through the session proxy (allowlist format:
# name, *.suffix, optional :ports, default 443). Everything else is
# refused and audited.
allow = api.example.com
# Shared lists from /usr/share/basalt-agent/egress (registries, github).
#include = registries
# A name that should resolve to a local or private address (a model server
# on the LAN) needs "private"; any port works through the proxy:
#allow = models.lab.example:11434 private
# Unprivileged loopback ports (1024 and up), e.g. a dev server the agent
# started. On by default. The kernel routes the host's own addresses over
# loopback too, so this also reaches services listening on the host's LAN
# address. Set no when the agent does not need local services.
#loopback = yes
