#!/usr/bin/env bash
# Download a model for the optional local model service (basalt-llm) and
# verify it against the pinned SHA-256 of models.manifest.
#
#   basalt-llm-fetch --list                 models in the manifest, and which are present
#   basalt-llm-fetch NAME                   download NAME into the model directory
#   basalt-llm-fetch --verify [NAME]        re-check the checksum of downloaded models
#
# Options: --dir DIR (default /var/lib/basalt-llm/models),
#          --manifest FILE (default /usr/share/basalt-llm/models.manifest).
#
# The download is the only network access the model needs, and it happens
# here, run by an administrator, never in the model service (which has no
# network at all). A file whose checksum does not match is deleted.
set -euo pipefail

DIR="${BASALT_LLM_MODEL_DIR:-/var/lib/basalt-llm/models}"
MANIFEST="${BASALT_LLM_MANIFEST:-/usr/share/basalt-llm/models.manifest}"
mode=fetch
name=""

die() { printf 'basalt-llm-fetch: %s\n' "$*" >&2; exit 1; }
usage() { sed -n '2,15s/^# \{0,1\}//p' "$0"; exit "${1:-0}"; }

while (($#)); do
  case "$1" in
    --list) mode=list ;;
    --verify) mode=verify ;;
    --dir) DIR="${2:?--dir needs a directory}"; shift ;;
    --manifest) MANIFEST="${2:?--manifest needs a file}"; shift ;;
    -h | --help) usage 0 ;;
    -*) die "unknown option $1" ;;
    *) [[ -z "$name" ]] || die "one model at a time"; name="$1" ;;
  esac
  shift
done

[[ -r "$MANIFEST" ]] || die "manifest $MANIFEST not readable"

# entry NAME: prints "sha256 size license url" for NAME, fails if unknown.
entry() {
  awk -v n="$1" '!/^#/ && NF >= 5 && $1 == n {print $2, $3, $4, $5; found=1} END {exit !found}' "$MANIFEST"
}
names() { awk '!/^#/ && NF >= 5 {print $1}' "$MANIFEST"; }

check() { # check NAME SHA FILE
  local got
  got="$(sha256sum "$3" | awk '{print $1}')"
  [[ "$got" == "$2" ]]
}

case "$mode" in
  list)
    printf '%-18s %8s  %-10s %s\n' NAME MiB LICENSE STATE
    while read -r n; do
      read -r sha size lic _url < <(entry "$n")
      state=absent
      [[ -f "$DIR/$n.gguf" ]] && state=present
      printf '%-18s %8d  %-10s %s\n' "$n" $((size / 1048576)) "$lic" "$state"
    done < <(names)
    ;;
  verify)
    rc=0
    for n in ${name:-$(names)}; do
      read -r sha _size _lic _url < <(entry "$n") || die "unknown model $n"
      [[ -f "$DIR/$n.gguf" ]] || { [[ -z "$name" ]] && continue; die "$n is not downloaded"; }
      if check "$n" "$sha" "$DIR/$n.gguf"; then echo "$n: ok"; else echo "$n: CHECKSUM MISMATCH"; rc=1; fi
    done
    exit "$rc"
    ;;
  fetch)
    [[ -n "$name" ]] || usage 1
    read -r sha size lic url < <(entry "$name") || die "unknown model $name (see --list)"
    command -v curl >/dev/null || die "curl is needed to download"
    install -d -m 0755 "$DIR"
    dest="$DIR/$name.gguf"
    if [[ -f "$dest" ]] && check "$name" "$sha" "$dest"; then
      echo "$name: already present and verified ($dest)"
      exit 0
    fi
    echo "$name: $((size / 1048576)) MiB, license $lic"
    echo "  from $url"
    part="$dest.part"
    progress=(--progress-bar)
    [[ -t 2 ]] || progress=(--silent --show-error)
    curl -fL "${progress[@]}" --proto '=https' --retry 3 -C - -o "$part" "$url" || die "download failed (partial file kept for resume: $part)"
    if ! check "$name" "$sha" "$part"; then
      rm -f "$part"
      die "$name: checksum mismatch, file removed"
    fi
    chmod 0644 "$part"
    mv -f "$part" "$dest"
    command -v restorecon >/dev/null && restorecon "$dest" 2>/dev/null || true
    echo "$name: verified, saved as $dest"
    echo "Select it with MODEL=$name in /etc/basalt/llm.conf, then: systemctl restart basalt-llm"
    ;;
esac
