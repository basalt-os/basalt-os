# Basalt OS boot splash for the plymouth "script" plugin.
#
# Generated from brand/basalt-os/src/plymouth/basalt.script by the branding
# kit (src/build.py), once per language: the T_ placeholders below are
# filled in from the kit's catalog. Plymouth cannot know the system's
# language in the initramfs, so each language is its own theme (basalt,
# basalt-pt_BR) and the installer picks the one of the system's language.
#
# Layout, the same family as the GRUB theme and the login screen: the
# basalt-column background of the GRUB menu, the Basalt mark at 40% of the
# height with "Basalt OS" under it, and a short terra roxa line sweeping a
# dark track while the system starts. The mark draws in (ring, then core,
# then the name) and the core breathes slowly.
#
# The passphrase prompt (LUKS, or the fallback when TPM2 unlock fails) is a
# card like the login screen's: a lock, what to do, the entry with a terra
# roxa edge and bullets, and a line that says when a passphrase did not work.
#
# HiDPI: assets ship in several sizes (ring-<px>.png, entry-<scale>.png);
# the script picks them from the screen height so nothing sharp is
# upscaled (the soft background is). Renderers: simpledrm, virtio-gpu, i915, amdgpu,
# nouveau and the firmware framebuffer all give plymouth a plain surface;
# the script only draws images and text.

# ------------------------------------------------------------------ strings
t_unlock = "Desbloquear o disco";
t_hint = "Digite a senha ou a chave de recuperação.";
t_wrong = "Não funcionou. Tente de novo.";
t_updates = "Instalando atualizações. Não desligue o computador.";
t_firmware = "Atualizando o firmware. Não desligue o computador.";
t_restart = "Reiniciando";
t_poweroff = "Desligando";

Window.SetBackgroundTopColor(0.078, 0.090, 0.106);
Window.SetBackgroundBottomColor(0.078, 0.090, 0.106);

screen_x = Window.GetX();
screen_y = Window.GetY();
screen_w = Window.GetWidth();
screen_h = Window.GetHeight();

# UI scale for the dialog assets and text.
if (screen_h >= 2600) { ui = 3; }
else if (screen_h >= 1400) { ui = 2; }
else { ui = 1; }

# Mark size: about 14% of the screen height, snapped to a shipped asset size.
target = screen_h * 0.14;
if (target >= 352) { logo_px = 384; }
else if (target >= 288) { logo_px = 320; }
else if (target >= 224) { logo_px = 256; }
else if (target >= 176) { logo_px = 192; }
else if (target >= 144) { logo_px = 160; }
else if (target >= 112) { logo_px = 128; }
else { logo_px = 96; }

# In the initramfs plymouth renders text with label-freetype, which uses the
# system default sans font copied there by plymouth-populate-initrd and only
# honours the size; after switch-root label-pango resolves "Sans" the same way.
font_body = "Sans " + (12 * ui);
font_title = "Sans Bold " + (15 * ui);

# Text colors (r, g, b as 0..1).
light_r = 0.925; light_g = 0.906; light_b = 0.882;   # #ECE7E1, the shell's text
muted_r = 0.627; muted_g = 0.651; muted_b = 0.682;   # #A0A6AE
danger_r = 0.878; danger_g = 0.376; danger_b = 0.353; # #E0605A

center_x = screen_x + screen_w / 2;

# smooth: 0 before a, 1 after b, eased in between.
fun smooth(a, b, x) {
    if (x <= a) return 0;
    if (x >= b) return 1;
    t = (x - a) / (b - a);
    return t * t * (3 - 2 * t);
}

# ------------------------------------------------------------------ background
# The GRUB menu's background, scaled to cover the screen.
bg_image = Image("background-1080.png");
bg_scale = screen_w / bg_image.GetWidth();
if (screen_h / bg_image.GetHeight() > bg_scale) bg_scale = screen_h / bg_image.GetHeight();
bg_w = Math.Int(bg_image.GetWidth() * bg_scale + 1);
bg_h = Math.Int(bg_image.GetHeight() * bg_scale + 1);
bg_sprite = Sprite(bg_image.Scale(bg_w, bg_h));
bg_sprite.SetPosition(screen_x + (screen_w - bg_w) / 2, screen_y + (screen_h - bg_h) / 2, -100);

# ------------------------------------------------------------------ the mark and the name
ring_image = Image("ring-" + logo_px + ".png");
core_image = Image("core-" + logo_px + ".png");
logo_x = center_x - ring_image.GetWidth() / 2;
logo_y = screen_y + screen_h * 0.40 - ring_image.GetHeight() / 2;
ring_sprite = Sprite(ring_image);
ring_sprite.SetPosition(logo_x, logo_y, 10);
ring_sprite.SetOpacity(0);
core_sprite = Sprite(core_image);
core_sprite.SetPosition(logo_x, logo_y, 11);
core_sprite.SetOpacity(0);

name_image = Image("wordmark-" + ui + ".png");
name_y = logo_y + ring_image.GetHeight() + 22 * ui;
name_sprite = Sprite(name_image);
name_sprite.SetPosition(center_x - name_image.GetWidth() / 2, name_y, 10);
name_sprite.SetOpacity(0);

below_name = name_y + name_image.GetHeight();

# ------------------------------------------------------------------ the sweeping line
bar_w = Math.Int(logo_px * 1.25);
bar_h = 2 * ui;
bar_x = center_x - bar_w / 2;
bar_y = below_name + 36 * ui;
seg_w = Math.Int(bar_w * 0.30);

track_sprite = Sprite(Image("track.png").Scale(bar_w, bar_h));
track_sprite.SetPosition(bar_x, bar_y, 10);
fill_source = Image("fill.png");
sweep_sprite = Sprite();
sweep_sprite.SetPosition(bar_x, bar_y, 11);
last_sweep_w = -1;
line_visible = 1;

fun set_line_visible(visible) {
    global.line_visible = visible;
    global.track_sprite.SetOpacity(visible);
    global.sweep_sprite.SetOpacity(visible);
}

# The sweep: a segment entering at the left, crossing, leaving at the right,
# clipped to the track (sprites cannot clip, so the image is resized).
fun draw_sweep(phase) {
    p = phase * phase * (3 - 2 * phase);
    left = global.bar_x - global.seg_w + (global.bar_w + global.seg_w) * p;
    right = left + global.seg_w;
    if (left < global.bar_x) left = global.bar_x;
    if (right > global.bar_x + global.bar_w) right = global.bar_x + global.bar_w;
    w = Math.Int(right - left);
    if (w < 1) {
        global.sweep_sprite.SetOpacity(0);
        return;
    }
    if (w != global.last_sweep_w) {
        global.sweep_sprite.SetImage(global.fill_source.Scale(w, global.bar_h));
        global.last_sweep_w = w;
    }
    global.sweep_sprite.SetPosition(left, global.bar_y, 11);
    global.sweep_sprite.SetOpacity(global.line_visible);
}

mode = Plymouth.GetMode();

# ------------------------------------------------------------------ titles (updates, shutdown)
title_sprite = Sprite();
title_sprite.SetPosition(0, 0, 20);
fun show_title(text, y) {
    image = Image.Text(text, global.light_r, global.light_g, global.light_b, 1, global.font_body);
    global.title_sprite.SetImage(image);
    global.title_sprite.SetPosition(global.center_x - image.GetWidth() / 2, y, 20);
}
if (mode == "updates" || mode == "system-upgrade") { show_title(t_updates, bar_y + 24 * ui); }
if (mode == "firmware-upgrade") { show_title(t_firmware, bar_y + 24 * ui); }
if (mode == "shutdown" || mode == "reboot") {
    set_line_visible(0);
    if (mode == "reboot") { show_title(t_restart, below_name + 32 * ui); }
    else { show_title(t_poweroff, below_name + 32 * ui); }
}

# ------------------------------------------------------------------ messages
message_sprite = Sprite();
message_sprite.SetPosition(0, 0, 20);

fun show_message(text) {
    image = Image.Text(text, global.muted_r, global.muted_g, global.muted_b, 1, global.font_body);
    global.message_sprite.SetImage(image);
    global.message_sprite.SetPosition(global.center_x - image.GetWidth() / 2,
                                      global.screen_y + global.screen_h - 72 * global.ui, 20);
    global.message_sprite.SetOpacity(1);
}

fun hide_message(text) {
    global.message_sprite.SetOpacity(0);
}

Plymouth.SetMessageFunction(show_message);
Plymouth.SetDisplayMessageFunction(show_message);
Plymouth.SetHideMessageFunction(hide_message);

# ------------------------------------------------------------------ passphrase / question card
panel_image = Image("panel-" + ui + ".png");
entry_image = Image("entry-" + ui + ".png");
bullet_image = Image("bullet-" + ui + ".png");
lock_image = Image("lock-" + ui + ".png");

panel_x = center_x - panel_image.GetWidth() / 2;
panel_y = below_name + 28 * ui;
pad = 24 * ui;

panel_sprite = Sprite(panel_image);
panel_sprite.SetPosition(panel_x, panel_y, 29);
lock_sprite = Sprite(lock_image);
lock_sprite.SetPosition(panel_x + pad, panel_y + pad, 30);

text_x = panel_x + pad + lock_image.GetWidth() + 14 * ui;
title_y = panel_y + pad - 2 * ui;
title_image = Image.Text(t_unlock, light_r, light_g, light_b, 1, font_title);
prompt_title = Sprite(title_image);
prompt_title.SetPosition(text_x, title_y, 30);
hint_y = title_y + title_image.GetHeight() + 4 * ui;
prompt_hint = Sprite();
prompt_hint.SetPosition(text_x, hint_y, 30);

entry_x = center_x - entry_image.GetWidth() / 2;
entry_y = panel_y + pad + lock_image.GetHeight() + 22 * ui;
entry_sprite = Sprite(entry_image);
entry_sprite.SetPosition(entry_x, entry_y, 30);
answer_sprite = Sprite();
answer_sprite.SetPosition(entry_x + 16 * ui, entry_y, 31);

error_y = entry_y + entry_image.GetHeight() + 12 * ui;
error_image = Image.Text(t_wrong, danger_r, danger_g, danger_b, 1, font_body);
error_sprite = Sprite(error_image);
error_sprite.SetPosition(center_x - error_image.GetWidth() / 2, error_y, 30);

bullet_step = bullet_image.GetWidth() + 7 * ui;
bullet_x0 = entry_x + 18 * ui;
bullet_y = entry_y + (entry_image.GetHeight() - bullet_image.GetHeight()) / 2;
bullet_max = Math.Int((entry_image.GetWidth() - 36 * ui) / bullet_step);
bullet_count = 0;

dialog_active = 0;
dialog_shown = 0;      # 0..1, eased in by the refresh function
answered_prompt = "";  # the prompt the person last answered
show_error = 0;

fun set_dialog_opacity(o) {
    global.panel_sprite.SetOpacity(o);
    global.lock_sprite.SetOpacity(o);
    global.prompt_title.SetOpacity(o);
    global.prompt_hint.SetOpacity(o);
    global.entry_sprite.SetOpacity(o);
    global.answer_sprite.SetOpacity(o * global.answer_visible);
    global.error_sprite.SetOpacity(o * global.show_error);
    for (i = 0; i < global.bullet_count; i++)
        global.bullets[i].SetOpacity(o * global.bullet_on[i]);
}
answer_visible = 0;
set_dialog_opacity(0);

fun begin_dialog(prompt) {
    global.dialog_active = 1;
    set_line_visible(0);
    global.title_sprite.SetOpacity(0);
    # The same question again after an answer: that answer did not work.
    if (global.answered_prompt != "" && global.answered_prompt == prompt) global.show_error = 1;
    global.current_prompt = prompt;
    global.prompt_hint.SetImage(Image.Text(global.t_hint, global.muted_r, global.muted_g, global.muted_b, 1, global.font_body));
}

fun display_password_callback(prompt, bullets) {
    begin_dialog(prompt);
    global.answer_visible = 0;
    if (bullets > 0) global.show_error = 0;
    shown = bullets;
    if (shown > global.bullet_max) shown = global.bullet_max;
    for (i = 0; i < shown; i++) {
        if (i >= global.bullet_count) {
            global.bullets[i] = Sprite(global.bullet_image);
            global.bullets[i].SetPosition(global.bullet_x0 + i * global.bullet_step, global.bullet_y, 32);
            global.bullet_count = i + 1;
        }
        global.bullet_on[i] = 1;
    }
    for (i = shown; i < global.bullet_count; i++)
        global.bullet_on[i] = 0;
    set_dialog_opacity(global.dialog_shown);
}

fun display_question_callback(prompt, entry) {
    begin_dialog(prompt);
    for (i = 0; i < global.bullet_count; i++)
        global.bullet_on[i] = 0;
    image = Image.Text(entry, global.light_r, global.light_g, global.light_b, 1, global.font_body);
    global.answer_sprite.SetImage(image);
    global.answer_sprite.SetPosition(global.entry_x + 18 * global.ui,
                                     global.entry_y + (global.entry_image.GetHeight() - image.GetHeight()) / 2, 31);
    global.answer_visible = 1;
    set_dialog_opacity(global.dialog_shown);
}

fun display_normal_callback() {
    if (global.dialog_active) global.answered_prompt = global.current_prompt;
    global.dialog_active = 0;
    global.show_error = 0;
    global.dialog_shown = 0;
    set_dialog_opacity(0);
    if (global.mode != "shutdown" && global.mode != "reboot")
        set_line_visible(1);
    global.title_sprite.SetOpacity(1);
}

Plymouth.SetDisplayPasswordFunction(display_password_callback);
Plymouth.SetDisplayQuestionFunction(display_question_callback);
Plymouth.SetDisplayNormalFunction(display_normal_callback);

# ------------------------------------------------------------------ motion (50 frames a second)
tick = 0;
fun refresh_callback() {
    global.tick++;
    t = global.tick;
    # Draw in: the ring, then the core, then the name.
    global.ring_sprite.SetOpacity(smooth(0, 28, t));
    intro_core = smooth(8, 36, t);
    global.name_sprite.SetOpacity(smooth(16, 44, t));
    # Then the core breathes (about 2.5 s a cycle); steady during a prompt.
    if (global.dialog_active || t < 36) {
        global.core_sprite.SetOpacity(intro_core);
    } else {
        global.core_sprite.SetOpacity(0.82 + 0.18 * Math.Cos((t - 36) * 0.05));
    }
    if (global.line_visible && !global.dialog_active) {
        draw_sweep(t / 90 - Math.Int(t / 90));
    }
    if (global.dialog_active && global.dialog_shown < 1) {
        global.dialog_shown = global.dialog_shown + 0.125;
        if (global.dialog_shown > 1) global.dialog_shown = 1;
        set_dialog_opacity(global.dialog_shown);
    }
}
Plymouth.SetRefreshFunction(refresh_callback);
