# Signature checks of the Basalt OS non-free repositories, enforced by
# basalt-nonfree-release (see 20-basalt-signatures.repo from basalt-release:
# dnf applies these after /etc/yum.repos.d, so an older or edited
# basalt-nonfree.repo cannot turn them off; only a file under
# /etc/dnf/repos.override.d can, on purpose). Do not edit: an upgrade
# replaces this file.
[basalt-nonfree]
gpgcheck=1
repo_gpgcheck=1
gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-basalt

[basalt-nonfree-source]
gpgcheck=1
repo_gpgcheck=1
gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-basalt

[basalt-nonfree-testing]
gpgcheck=1
repo_gpgcheck=1
gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-basalt
