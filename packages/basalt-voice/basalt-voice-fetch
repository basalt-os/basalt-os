#!/usr/bin/env bash
# Download a model for the desktop's voice (speech to text, voice activity
# detection, text to speech) and verify it against the pinned SHA-256 of
# models.manifest.
#
#   basalt-voice-fetch --list            models in the manifest, and which are present
#   basalt-voice-fetch NAME...           download into the model directory
#   basalt-voice-fetch default           the default set: ggml-base.en, ggml-silero-v5.1.2, en_US-ljspeech-medium (+ .json)
#   basalt-voice-fetch english           speech in English: ggml-base.en and ggml-silero-v5.1.2
#   basalt-voice-fetch multilingual      for speech in other languages: ggml-base-q5_1 and ggml-silero-v5.1.2
#                                        (ggml-small-q5_1, slower, is better for long dictation: fetch it by name)
#   basalt-voice-fetch --verify          re-check the checksums of downloaded models
#   basalt-voice-fetch --plan NAME...    what a download would fetch (machine readable, no root)
#   basalt-voice-fetch --remove NAME...  delete downloaded models
#
# Options: --dir DIR (default /var/lib/basalt-voice/models),
#          --manifest FILE (default /usr/share/basalt-voice/models.manifest),
#          --porcelain (--list: the machine-readable lines of --plan),
#          --status FILE (progress for the desktop, written while downloading).
#
# The download is the only network access voice needs, and it happens
# here, run by an administrator or by the desktop's confined download
# service after the person said yes (basalt-models), never in the voice
# service (which has no network at all). A file whose checksum does not
# match is deleted.
#
# Exit status: 0 done, 1 usage or other error, 3 the network or the
# server could not be reached (a partial file is kept for the retry),
# 4 checksum mismatch (the file was deleted), 5 the model directory is
# not writable.
set -euo pipefail
DIR="${BASALT_VOICE_MODEL_DIR:-/var/lib/basalt-voice/models}"
MANIFEST="${BASALT_VOICE_MANIFEST:-/usr/share/basalt-voice/models.manifest}"
mode=fetch
porcelain=0
STATUS=""
names=()
die() { printf 'basalt-voice-fetch: %s\n' "$*" >&2; exit 1; }
while (($#)); do
  case "$1" in
    --list) mode=list ;;
    --verify) mode=verify ;;
    --plan) mode=plan ;;
    --remove) mode=remove ;;
    --porcelain) porcelain=1 ;;
    --status) STATUS="${2:?--status needs a file}"; shift ;;
    --dir) DIR="${2:?--dir needs a directory}"; shift ;;
    --manifest) MANIFEST="${2:?--manifest needs a file}"; shift ;;
    -h | --help) sed -n '2,32s/^# \{0,1\}//p' "$0"; exit 0 ;;
    default) names+=(ggml-base.en ggml-silero-v5.1.2 en_US-ljspeech-medium en_US-ljspeech-medium.json) ;;
    english) names+=(ggml-base.en ggml-silero-v5.1.2) ;;
    multilingual | default-multilingual) names+=(ggml-base-q5_1 ggml-silero-v5.1.2) ;;
    -*) die "unknown option $1" ;;
    *) names+=("$1") ;;
  esac
  shift
done
[[ -r "$MANIFEST" ]] || die "manifest $MANIFEST not readable"
entry() { awk -v n="$1" '!/^#/ && NF >= 5 && $1 == n {print $2, $3, $4, $5; found=1} END {exit !found}' "$MANIFEST"; }
file_of() { local url=$1; basename "${url%%\?*}"; }
host_of() { local u=${1#*://}; echo "${u%%/*}"; }
# present FILE SHA: the file exists and matches its checksum.
present() { [[ -f "$1" ]] && echo "$2  $1" | sha256sum -c --quiet - >/dev/null 2>&1; }

# The same name twice (a set and a name of it) is fetched once.
uniq_names() {
  local -A seen=()
  local n out=()
  for n in "${names[@]}"; do
    [[ -n "${seen[$n]:-}" ]] && continue
    seen[$n]=1
    out+=("$n")
  done
  names=("${out[@]}")
}
((${#names[@]})) && uniq_names

# Progress for the desktop: key=value lines, replaced atomically, readable
# by everyone (sizes and names only).
status() {
  [[ -n "$STATUS" ]] || return 0
  local t="$STATUS.tmp.$$"
  printf '%s\n' "time=$(date +%s)" "$@" >"$t" && chmod 0644 "$t" && mv -f "$t" "$STATUS"
}

# plan_line NAME: "name size license host present|absent" for one model
# (present: the file is there with its size; the download and --verify
# check the SHA-256, this answer has to be quick).
plan_line() {
  local n=$1 sha size lic url st=absent f
  read -r sha size lic url < <(entry "$n") || return 1
  f="$DIR/$(file_of "$url")"
  [[ -f "$f" && "$(stat -c %s "$f")" == "$size" ]] && st=present
  printf '%s %s %s %s %s\n' "$n" "$size" "$lic" "$(host_of "$url")" "$st"
}

case "$mode" in
  list)
    if ((porcelain)); then
      awk '!/^#/ && NF >= 5 {print $1}' "$MANIFEST" | while read -r n; do plan_line "$n"; done
      exit 0
    fi
    awk '!/^#/ && NF >= 5 {print $1, $3, $4, $5}' "$MANIFEST" | while read -r n size lic url; do
      f="$DIR/$(file_of "$url")"
      st="-"; [[ -f "$f" ]] && st="present"
      printf '%-26s %6d MiB  %-20s %s\n' "$n" $((size / 1048576)) "$lic" "$st"
    done ;;
  plan)
    ((${#names[@]})) || die "which model? (--list shows them)"
    for n in "${names[@]}"; do plan_line "$n" || { echo "basalt-voice-fetch: no model $n in the manifest" >&2; exit 2; }; done ;;
  verify)
    rc=0
    while read -r n sha url; do
      f="$DIR/$(file_of "$url")"
      [[ -f "$f" ]] || continue
      if echo "$sha  $f" | sha256sum -c --quiet - 2>/dev/null; then echo "$n: ok"; else echo "$n: CHECKSUM MISMATCH ($f)"; rc=1; fi
    done < <(awk '!/^#/ && NF >= 5 {print $1, $2, $5}' "$MANIFEST")
    exit $rc ;;
  remove)
    ((${#names[@]})) || die "which model? (--list shows them)"
    [[ -w "$DIR" ]] || { echo "basalt-voice-fetch: $DIR is not writable (run as root)" >&2; exit 5; }
    for n in "${names[@]}"; do
      read -r _sha _size _lic url < <(entry "$n") || die "no model $n in the manifest"
      f="$DIR/$(file_of "$url")"
      rm -f "$f" "$f.part"
      echo "$n: removed"
    done ;;
  fetch)
    ((${#names[@]})) || die "which model? (--list shows them, default fetches the default set)"
    if [[ ! -w "$DIR" ]]; then
      status state=failed error=storage "message=$DIR is not writable"
      echo "basalt-voice-fetch: $DIR is not writable (run as root)" >&2
      exit 5
    fi
    # What is missing, and how much that is in all.
    todo=() total=0
    for n in "${names[@]}"; do
      read -r sha size lic url < <(entry "$n") || { status state=failed error=unknown "message=no model $n"; die "no model $n in the manifest"; }
      if present "$DIR/$(file_of "$url")" "$sha"; then echo "$n: already present"; continue; fi
      todo+=("$n")
      total=$((total + size))
    done
    done_bytes=0 i=0
    for n in "${todo[@]}"; do
      i=$((i + 1))
      read -r sha size lic url < <(entry "$n")
      f="$DIR/$(file_of "$url")"
      tmp="$f.part"
      echo "$n: downloading $((size / 1048576)) MiB ($lic)"
      status state=downloading "model=$n" "index=$i" "count=${#todo[@]}" "bytes=$done_bytes" "total=$total"
      # A partial file from an earlier attempt is resumed; one that is
      # already complete (or too long) is not sent to the server again.
      if [[ -f "$tmp" ]] && (($(stat -c %s "$tmp") >= size)); then
        present "$tmp" "$sha" || rm -f "$tmp"
      fi
      rc=0
      if [[ -f "$tmp" ]] && (($(stat -c %s "$tmp") == size)); then
        : # complete and verified above
      elif [[ -n "$STATUS" ]]; then
        # In the background, so the progress can be written while it runs.
        curl -fsSL --proto '=https' --connect-timeout 20 --speed-limit 1024 --speed-time 60 --retry 3 -C - -o "$tmp" "$url" &
        pid=$!
        while kill -0 "$pid" 2>/dev/null; do
          cur=$(stat -c %s "$tmp" 2>/dev/null || echo 0)
          status state=downloading "model=$n" "index=$i" "count=${#todo[@]}" "bytes=$((done_bytes + cur))" "total=$total"
          sleep 0.5
        done
        wait "$pid" || rc=$?
      else
        curl -fL --proto '=https' --connect-timeout 20 --speed-limit 1024 --speed-time 60 --retry 3 -C - -o "$tmp" "$url" || rc=$?
      fi
      if ((rc != 0)); then
        case $rc in
          # No name resolution, no connection, a timeout (also a dead
          # connection: under 1 KiB/s for a minute), TLS, or the connection
          # broke mid-transfer: keep the partial file, the retry resumes it.
          5 | 6 | 7 | 18 | 28 | 35 | 52 | 55 | 56)
            status state=failed error=network "model=$n" "index=$i" "count=${#todo[@]}" "bytes=$done_bytes" "total=$total" "message=curl exit $rc"
            echo "basalt-voice-fetch: $n: the server could not be reached (curl exit $rc); run again to resume" >&2
            exit 3 ;;
          *)
            rm -f "$tmp"
            status state=failed error=download "model=$n" "message=curl exit $rc"
            die "download of $n failed (curl exit $rc)" ;;
        esac
      fi
      status state=verifying "model=$n" "index=$i" "count=${#todo[@]}" "bytes=$((done_bytes + size))" "total=$total"
      if ! echo "$sha  $tmp" | sha256sum -c --quiet - >/dev/null 2>&1; then
        rm -f "$tmp"
        status state=failed error=checksum "model=$n" "message=checksum mismatch, file removed"
        echo "basalt-voice-fetch: $n: checksum mismatch, file removed" >&2
        exit 4
      fi
      chmod 0644 "$tmp"; mv "$tmp" "$f"
      if command -v restorecon >/dev/null; then restorecon "$f" 2>/dev/null || true; fi
      done_bytes=$((done_bytes + size))
      echo "$n: ok -> $f"
    done
    status state=done "count=${#todo[@]}" "bytes=$done_bytes" "total=$total" ;;
esac
