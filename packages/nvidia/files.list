# NVIDIA userspace files taken from the official .run, and where they go.
#
# This list is the single source of truth for nvidia-driver.spec (what each
# binary package installs) and for check-identical.sh (every installed
# NVIDIA file must be byte-identical to the same file in the .run). Files
# are copied as they are: never stripped, patched, compressed or relinked.
#
#   file SUBPACKAGE MODE SOURCE DESTINATION   a file from the extracted .run
#   link SUBPACKAGE DESTINATION TARGET        a symbolic link we create (as
#                                             NVIDIA's installer does)
#
# @V@ is the driver version, @LIB@ the 64-bit library directory (/usr/lib64).
# Not taken from the .run: the glvnd dispatch libraries, the OpenCL loader
# and the EGL external platform libraries (Fedora's libglvnd, ocl-icd,
# egl-wayland, egl-wayland2, egl-gbm and egl-x11, built from source), the
# X.Org driver and GLX server module (no X server in Basalt OS), the
# installer, nvidia-settings and nvidia-xconfig (X11 tools), nvidia-modprobe
# and nvidia-persistenced (built from their GitHub sources instead), the
# DLSS updater (it downloads code), Vulkan SC, nvidia-pcc, the PKCS #11
# library built for OpenSSL 1.1 (the OpenSSL 3 one is shipped) and the
# 32-bit compatibility libraries.

# --- libs: OpenGL, EGL, GLES, Vulkan, GBM, VDPAU, ray tracing ---------------
file libs 0755 libGLX_nvidia.so.@V@ @LIB@/libGLX_nvidia.so.@V@
link libs @LIB@/libGLX_nvidia.so.0 libGLX_nvidia.so.@V@
file libs 0755 libEGL_nvidia.so.@V@ @LIB@/libEGL_nvidia.so.@V@
link libs @LIB@/libEGL_nvidia.so.0 libEGL_nvidia.so.@V@
file libs 0755 libGLESv2_nvidia.so.@V@ @LIB@/libGLESv2_nvidia.so.@V@
link libs @LIB@/libGLESv2_nvidia.so.2 libGLESv2_nvidia.so.@V@
file libs 0755 libGLESv1_CM_nvidia.so.@V@ @LIB@/libGLESv1_CM_nvidia.so.@V@
link libs @LIB@/libGLESv1_CM_nvidia.so.1 libGLESv1_CM_nvidia.so.@V@
file libs 0755 libnvidia-glcore.so.@V@ @LIB@/libnvidia-glcore.so.@V@
file libs 0755 libnvidia-eglcore.so.@V@ @LIB@/libnvidia-eglcore.so.@V@
file libs 0755 libnvidia-glsi.so.@V@ @LIB@/libnvidia-glsi.so.@V@
file libs 0755 libnvidia-tls.so.@V@ @LIB@/libnvidia-tls.so.@V@
file libs 0755 libnvidia-glvkspirv.so.@V@ @LIB@/libnvidia-glvkspirv.so.@V@
file libs 0755 libnvidia-allocator.so.@V@ @LIB@/libnvidia-allocator.so.@V@
link libs @LIB@/libnvidia-allocator.so.1 libnvidia-allocator.so.@V@
link libs @LIB@/gbm/nvidia-drm_gbm.so ../libnvidia-allocator.so.1
file libs 0755 libnvidia-rtcore.so.@V@ @LIB@/libnvidia-rtcore.so.@V@
file libs 0755 libnvoptix.so.@V@ @LIB@/libnvoptix.so.@V@
link libs @LIB@/libnvoptix.so.1 libnvoptix.so.@V@
file libs 0644 nvoptix.bin /usr/share/nvidia/nvoptix.bin
file libs 0755 libnvidia-ngx.so.@V@ @LIB@/libnvidia-ngx.so.@V@
file libs 0755 libnvidia-present.so.@V@ @LIB@/libnvidia-present.so.@V@
file libs 0755 libnvidia-api.so.1 @LIB@/libnvidia-api.so.1
file libs 0755 libnvidia-fbc.so.@V@ @LIB@/libnvidia-fbc.so.@V@
link libs @LIB@/libnvidia-fbc.so.1 libnvidia-fbc.so.@V@
file libs 0755 libvdpau_nvidia.so.@V@ @LIB@/vdpau/libvdpau_nvidia.so.@V@
link libs @LIB@/vdpau/libvdpau_nvidia.so.1 libvdpau_nvidia.so.@V@
file libs 0755 nvngx.dll @LIB@/nvidia/wine/nvngx.dll
file libs 0755 _nvngx.dll @LIB@/nvidia/wine/_nvngx.dll
file libs 0755 nvngx_dlssg.dll @LIB@/nvidia/wine/nvngx_dlssg.dll
file libs 0644 10_nvidia.json /usr/share/glvnd/egl_vendor.d/10_nvidia.json
file libs 0644 nvidia_icd.json /usr/share/vulkan/icd.d/nvidia_icd.json
file libs 0644 nvidia_layers.json /usr/share/vulkan/implicit_layer.d/nvidia_layers.json
file libs 0644 nvidia-application-profiles-@V@-rc /usr/share/nvidia/nvidia-application-profiles-@V@-rc
file libs 0644 nvidia-application-profiles-@V@-key-documentation /usr/share/nvidia/nvidia-application-profiles-@V@-key-documentation

