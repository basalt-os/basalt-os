[Unit]
Description=Basalt ledger: append-only system audit service
Documentation=https://github.com/basalt-os/basalt-os/blob/main/docs/ledger.md
After=systemd-journald.service local-fs.target
Before=multi-user.target

[Service]
Type=exec
ExecStart=/usr/libexec/basalt-ledger/basalt-ledgerd
Restart=on-failure
RestartSec=2
RuntimeDirectory=basalt-ledger
RuntimeDirectoryMode=0755
LogsDirectory=basalt-ledger
LogsDirectoryMode=0755
# CAP_LINUX_IMMUTABLE: append-only and immutable attributes on the files.
CapabilityBoundingSet=CAP_LINUX_IMMUTABLE
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/log/basalt-ledger
ProtectHome=yes
PrivateTmp=yes
PrivateNetwork=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
