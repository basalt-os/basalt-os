#!/usr/bin/bash
# GRUB menu entries that boot snapshots of the root file system read-only.
#
#   basalt-snapshot-boot update   rewrite /boot/grub2/basalt-snapshots.cfg
#   basalt-snapshot-boot list     print the entries the menu contains
#   basalt-snapshot-boot status   say whether the running system is a snapshot
#
# GRUB sources the menu file through /etc/grub.d/42_basalt_snapshots, so an
# update only rewrites one small file on /boot; grub2-mkconfig is not needed.
#
# Each entry boots a kernel from /boot with the root file system mounted from
# the snapshot (rootflags=subvol=...). Snapshots are read-only btrfs
# subvolumes, so the system comes up read-only; data subvolumes (/home,
# /var/log, /var/lib/...) are mounted from /etc/fstab as usual. To keep the
# booted snapshot, run `basalt-rollback` (snapper rollback) and reboot.
#
# The kernel for a snapshot is the newest one that is still in /boot and
# whose modules exist inside the snapshot, so the booted userspace matches
# its kernel. Snapshots with no such kernel get no entry.
set -euo pipefail

BOOT_MENU_LIMIT=8
[[ -r /etc/basalt/snapshots.conf ]] && . /etc/basalt/snapshots.conf

SNAPDIR=/.snapshots
OUT=/boot/grub2/basalt-snapshots.cfg

die() { printf 'basalt-snapshot-boot: %s\n' "$*" >&2; exit 1; }

# Value of a simple element in a snapper info.xml file.
xml_value() {
  sed -n "s:.*<$2>\(.*\)</$2>.*:\1:p" "$1" | head -1 |
    sed 's/&lt;/</g; s/&gt;/>/g; s/&quot;/"/g; s/&apos;/'"'"'/g; s/&amp;/\&/g'
}

# Kernel command line for snapshot entries: the configured one without any
# root subvolume selection, BOOT_IMAGE, or ro/rw (added explicitly).
base_cmdline() {
  local line=""
  if [[ -s /etc/kernel/cmdline ]]; then
    line="$(tr -s '[:space:]' ' ' </etc/kernel/cmdline)"
  elif command -v grubby >/dev/null; then
    line="$(grubby --info=DEFAULT 2>/dev/null | sed -n 's/^args="\(.*\)"$/\1/p')"
  fi
  [[ -n "$line" ]] || line="$(cat /proc/cmdline)"
  local out=() w
  for w in $line; do
    case "$w" in
      BOOT_IMAGE=*|initrd=*|ro|rw|rootflags=*|basalt.snapshot=*|*\$*) ;;
      *) out+=("$w") ;;
    esac
  done
  printf '%s' "${out[*]}"
}

# Installed kernels with both a kernel image and an initramfs on /boot,
# newest first.
boot_kernels() {
  local f k
  for f in /boot/vmlinuz-*; do
    [[ -e "$f" ]] || continue
    k="${f#/boot/vmlinuz-}"
    [[ "$k" == *rescue* ]] && continue
    [[ -f "/boot/initramfs-$k.img" ]] || continue
    printf '%s\n' "$k"
  done | sort -rV
}

# GRUB single-quoted string: keep printable text, drop quotes and backslashes.
grub_text() { printf '%s' "$1" | tr -d "'\\\\\`" | tr -c '[:print:]' ' '; }

# Snapshot numbers that can be listed in the menu, newest first.
candidate_snapshots() {
  local d n type
  for d in "$SNAPDIR"/*/; do
    n="$(basename "$d")"
    [[ "$n" =~ ^[0-9]+$ && "$n" != 0 ]] || continue
    [[ -f "$d/info.xml" && -d "$d/snapshot" ]] || continue
    type="$(xml_value "$d/info.xml" type)"
    # A "post" snapshot is the state right after a transaction; the
    # interesting states to go back to are "pre" and "single".
    [[ "$type" == post ]] && continue
    printf '%s\n' "$n"
  done | sort -rn
}

# Booted from this menu? Its entries add basalt.snapshot=N to the command line.
booted_snapshot() {
  tr ' ' '\n' </proc/cmdline | sed -n 's/^basalt\.snapshot=\([0-9]*\)$/\1/p'
}

generate() {
  local boot_uuid opts kernels n info date desc type path k kver count=0
  [[ "$(findmnt -no FSTYPE /)" == btrfs ]] || { echo "# root file system is not btrfs"; return 0; }
  [[ -d "$SNAPDIR" ]] || { echo "# no $SNAPDIR"; return 0; }
  if ! mountpoint -q /boot; then
    echo "# /boot is not a separate file system: snapshot entries are not supported on this layout"
    return 0
  fi
  boot_uuid="$(findmnt -no UUID /boot)"
  opts="$(base_cmdline)"
  # After a rollback the default subvolume is itself a snapshot: that is the
  # normal boot, not an entry for this menu.
  local default_id
  default_id="$(btrfs subvolume get-default / 2>/dev/null | awk '{print $2}')"
  mapfile -t kernels < <(boot_kernels)

  echo "# Generated by basalt-snapshot-boot on $(date -u +%Y-%m-%dT%H:%M:%SZ). Do not edit."
  # --hotkey=s: pressing "s" in the main menu opens this submenu directly.
  # --class basalt-snapshot first: the GRUB theme shows its clock icon.
  echo "submenu 'Basalt OS snapshots (read-only, key s)' --class basalt-snapshot --class basalt --hotkey=s --id basalt-snapshots {"
  for n in $(candidate_snapshots); do
    (( count < BOOT_MENU_LIMIT )) || break
    info="$SNAPDIR/$n/info.xml"
    type="$(xml_value "$info" type)"
    date="$(xml_value "$info" date)"
    desc="$(xml_value "$info" description)"
    # Path of the snapshot subvolume relative to the top of the file system,
    # e.g. root/.snapshots/12/snapshot (first line of `btrfs subvolume show`).
    path="$(btrfs subvolume show "$SNAPDIR/$n/snapshot" 2>/dev/null | head -1)" || continue
    [[ -n "$path" && "$path" != / ]] || continue
    [[ "$(btrfs inspect-internal rootid "$SNAPDIR/$n/snapshot" 2>/dev/null)" != "$default_id" ]] || continue
    kver=""
    for k in "${kernels[@]}"; do
      if [[ -d "$SNAPDIR/$n/snapshot/usr/lib/modules/$k" ]]; then kver="$k"; break; fi
    done
    if [[ -z "$kver" ]]; then
      echo "  # snapshot $n: no kernel on /boot matches its modules, skipped"
      continue
    fi
    local label="Snapshot $n, ${date} UTC"
    [[ "$type" == pre ]] && label+=", before: ${desc}" || label+=": ${desc}"
    label="$(grub_text "${label:0:110}")"
    cat <<EOF
  menuentry '${label}' --class basalt-snapshot --class basalt --unrestricted --id 'basalt-snapshot-${n}' {
    insmod part_gpt
    insmod ext2
    insmod xfs
    search --no-floppy --fs-uuid --set=root ${boot_uuid}
    echo 'Booting snapshot ${n} read-only (kernel ${kver})'
    linux /vmlinuz-${kver} ${opts} ro rootflags=subvol=${path} basalt.snapshot=${n}
    initrd /initramfs-${kver}.img
  }
EOF
    count=$((count + 1))
  done
  (( count > 0 )) || echo "  # no bootable snapshots yet"
  echo "}"
}

update() {
  [[ -d /boot/grub2 ]] || die "no /boot/grub2 (GRUB is not the boot loader?)"
  local tmp
  tmp="$(mktemp /boot/grub2/.basalt-snapshots.cfg.XXXXXX)"
  if ! generate >"$tmp"; then rm -f "$tmp"; die "could not generate the menu"; fi
  chmod 0600 "$tmp"
  mv -f "$tmp" "$OUT"
  command -v restorecon >/dev/null && restorecon "$OUT" 2>/dev/null || true
}

case "${1:-}" in
  update) update ;;
  list)
    [[ -f "$OUT" ]] || die "no menu yet (basalt-snapshot-boot update)"
    sed -n "s/^  menuentry '\([^']*\)'.*/\1/p; s/^  # \(.*\)/(\1)/p" "$OUT" ;;
  status)
    n="$(booted_snapshot)"
    if [[ -n "$n" ]]; then
      echo "booted from snapshot $n (read-only). Keep it with: basalt-rollback; then reboot."
    else
      echo "booted from the default subvolume ($(btrfs subvolume get-default / 2>/dev/null | awk '{print $NF}'))"
    fi ;;
  *) sed -n '2,8p' "$0"; exit 2 ;;
esac
