{
  "registry": 1,
  "source": "basalt-shell-skills",
  "executors": {},
  "groups": {
    "skills.grant": [
      "grant.folder",
      "grant.mailbox",
      "grant.site"
    ],
    "skills.read": [
      "grant.folder",
      "grant.mailbox",
      "grant.site",
      "file.open"
    ]
  },
  "actions": [
    {
      "id": "grant.folder",
      "class": "C1",
      "description": "Let the assistant's read-only skills read and search the files of a folder (and below) for a while. A person's approval is kept as a rule that ends with the grant (asking again for the same scope before then is allowed without a new question); the grant itself can be revoked at any time.",
      "args": {
        "targets": {
          "type": "strings",
          "required": true,
          "max_items": 8
        },
        "duration": {
          "type": "string",
          "pattern": "[0-9]{1,6}(s|m|h|d)"
        }
      },
      "resources": [
        {
          "kind": "path",
          "arg": "targets[]",
          "beneath": true,
          "expand_home": true
        }
      ],
      "executor": "basalt-shell",
      "requesters": [
        "person"
      ],
      "grant_arg": "duration",
      "preview": {
        "show": [
          "targets",
          "duration"
        ]
      },
      "reversible": "none"
    },
    {
      "id": "grant.mailbox",
      "class": "C1",
      "description": "Let the assistant's read-only skills read and summarize a mailbox for a while (nothing is sent, deleted or marked as read). A person's approval is kept as a rule that ends with the grant (asking again for the same scope before then is allowed without a new question); the grant itself can be revoked at any time.",
      "args": {
        "targets": {
          "type": "strings",
          "required": true,
          "max_items": 8
        },
        "duration": {
          "type": "string",
          "pattern": "[0-9]{1,6}(s|m|h|d)"
        }
      },
      "resources": [
        {
          "kind": "mailbox",
          "arg": "targets[]"
        }
      ],
      "executor": "basalt-shell",
      "requesters": [
        "person"
      ],
      "grant_arg": "duration",
      "preview": {
        "show": [
          "targets",
          "duration"
        ]
      },
      "reversible": "none"
    },
    {
      "id": "grant.site",
      "class": "C3",
      "description": "Let the assistant's read-only skills read pages of a web site for a while (other sites stay blocked). A person's approval is kept as a rule that ends with the grant (asking again for the same scope before then is allowed without a new question); the grant itself can be revoked at any time.",
      "args": {
        "targets": {
          "type": "strings",
          "required": true,
          "max_items": 8
        },
        "duration": {
          "type": "string",
          "pattern": "[0-9]{1,6}(s|m|h|d)"
        }
      },
      "resources": [
        {
          "kind": "host",
          "arg": "targets[]"
        }
      ],
      "executor": "basalt-shell",
      "requesters": [
        "person"
      ],
      "grant_arg": "duration",
      "preview": {
        "show": [
          "targets",
          "duration"
        ]
      },
      "leaves": true
    },
    {
      "id": "file.open",
      "class": "C1",
      "description": "Open a file the assistant found, in its usual app.",
      "args": {
        "path": {
          "type": "string",
          "required": true,
          "max_len": 4096
        }
      },
      "resources": [
        {
          "kind": "path",
          "arg": "path",
          "expand_home": true
        }
      ],
      "executor": "basalt-shell",
      "preview": {
        "show": [
          "path"
        ]
      }
    }
  ]
