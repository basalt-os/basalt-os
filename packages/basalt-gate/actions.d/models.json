{
  "registry": 1,
  "source": "basalt-models",
  "executors": {
    "basalt-models-request": {
      "types": [],
      "note": "basalt-models-request claims from phase 2; until then nothing claims"
    }
  },
  "groups": {},
  "actions": [
    {
      "id": "model.download",
      "class": "C2",
      "system": true,
      "description": "Download a pinned model (voice or local language model) and check its checksum.",
      "args": {
        "kind": {
          "type": "string",
          "required": true,
          "enum": [
            "voice",
            "llm"
          ]
        },
        "what": {
          "type": "string",
          "required": true,
          "pattern": "[a-z0-9][a-z0-9._-]{0,63}"
        }
      },
      "resources": [
        {
          "kind": "model",
          "arg": "what"
        }
      ],
      "executor": "basalt-models-request",
      "requesters": [
        "person",
        "app"
      ],
      "preview": {
        "show": [
          "kind",
          "what"
        ]
      }
    },
    {
      "id": "model.remove",
      "class": "C2",
      "system": true,
      "reversible": "none",
      "description": "Remove a downloaded model.",
      "args": {
        "kind": {
          "type": "string",
          "required": true,
          "enum": [
            "voice",
            "llm"
          ]
        },
        "what": {
          "type": "string",
          "required": true,
          "pattern": "[a-z0-9][a-z0-9._-]{0,63}"
        }
      },
      "resources": [
        {
          "kind": "model",
          "arg": "what"
        }
      ],
      "executor": "basalt-models-request",
      "requesters": [
        "person",
        "app"
      ],
      "preview": {
        "show": [
          "kind",
          "what"
        ]
      }
    }
  ]
}
