{
  "registry": 1,
  "source": "basalt-assistant",
  "executors": {
    "basalt-gate-exec": {
      "types": ["basalt_gate_exec_t"],
      "uid": 0,
      "unit": "basalt-gate-exec@.service",
      "note": "the gate starts basalt-gate-exec@ID.service once a person (or a system rule) approves; it runs basalt apply ID --gate, which claims the decision and applies the proposal with its snapshots, checks and audit record"
    }
  },
  "groups": {
    "selinux.fix": ["selinux.fcontext", "selinux.restorecon", "selinux.port", "selinux.boolean"],
    "system.cleanup": ["journal.vacuum", "dnf.clean"],
    "system.updates": ["update.install", "update.rollback"],
    "system.channels": ["repo.enable", "repo.disable", "source.remove"],
    "system.keyboard": ["keyboard.system"],
    "system.security": ["audit.run", "risk.accept", "risk.review"]
  },
  "actions": [
    { "id": "selinux.fcontext", "class": "C2", "system": true, "snapshot": true, "reversible": "snapshot",
      "args": { "path": { "type": "string", "required": true, "pattern": "/[A-Za-z0-9._@+,:/ -]{1,1000}" },
                "type": { "type": "string", "required": true, "pattern": "[a-z][a-z0-9_]{0,120}_t" } },
      "resources": [ { "kind": "path", "arg": "path", "beneath": true } ],
      "executor": "basalt-gate-exec", "requesters": ["system-assistant"],
      "preview": { "show": ["path", "type"] } },
    { "id": "selinux.restorecon", "class": "C2", "system": true, "snapshot": true, "reversible": "snapshot",
      "args": { "path": { "type": "string", "required": true, "pattern": "/[A-Za-z0-9._@+,:/ -]{1,1000}" },
                "recursive": { "type": "string", "enum": ["yes", "no"] } },
      "resources": [ { "kind": "path", "arg": "path" } ],
      "executor": "basalt-gate-exec", "requesters": ["system-assistant"],
      "preview": { "show": ["path", "recursive"] } },
    { "id": "selinux.port", "class": "C2", "system": true, "snapshot": true, "reversible": "snapshot",
      "args": { "port": { "type": "string", "required": true, "pattern": "[0-9]{1,5}" },
                "proto": { "type": "string", "required": true, "enum": ["tcp", "udp", "sctp"] },
                "type": { "type": "string", "required": true, "pattern": "[a-z][a-z0-9_]{0,120}_t" },
                "mode": { "type": "string", "required": true, "enum": ["add", "modify"] } },
      "executor": "basalt-gate-exec", "requesters": ["system-assistant"],
      "preview": { "show": ["port", "proto", "type", "mode"] } },
    { "id": "selinux.boolean", "class": "C2", "system": true, "snapshot": true, "reversible": "snapshot",
      "args": { "name": { "type": "string", "required": true, "pattern": "[a-z][a-z0-9_]{0,120}" },
                "value": { "type": "string", "required": true, "enum": ["on", "off"] } },
      "resources": [ { "kind": "boolean", "arg": "name" } ],
      "executor": "basalt-gate-exec", "requesters": ["system-assistant"],
      "preview": { "show": ["name", "value"] } },
    { "id": "unit.restart", "class": "C2", "system": true, "snapshot": true, "reversible": "snapshot",
      "args": { "unit": { "type": "string", "required": true, "pattern": "[A-Za-z0-9@._:\\\\-]{1,200}\\.(service|socket|timer|mount|path|target)" } },
      "resources": [ { "kind": "unit", "arg": "unit" } ],
      "executor": "basalt-gate-exec", "requesters": ["system-assistant"],
      "preview": { "show": ["unit"] } },
    { "id": "file.restore", "class": "C2", "system": true, "snapshot": true, "reversible": "snapshot",
      "args": { "path": { "type": "string", "required": true, "pattern": "/etc/[A-Za-z0-9._@+,:/ -]{1,1000}" },
                "snapshot": { "type": "string", "required": true, "pattern": "[0-9]{1,7}" } },
      "resources": [ { "kind": "path", "arg": "path" } ],
      "executor": "basalt-gate-exec", "requesters": ["system-assistant"],
      "preview": { "show": ["path", "snapshot"] } },
    { "id": "snapshot.rollback", "class": "C2", "system": true, "reversible": "snapshot",
      "args": { "snapshot": { "type": "string", "required": true, "pattern": "[0-9]{1,7}" } },
      "executor": "basalt-gate-exec", "requesters": ["system-assistant"],
      "preview": { "show": ["snapshot"] } },
    { "id": "snapshot.delete", "class": "C5", "system": true, "reversible": "none",
      "args": { "snapshot": { "type": "string", "required": true, "pattern": "[0-9]{1,7}" } },
      "executor": "basalt-gate-exec", "requesters": ["system-assistant"],
      "preview": { "show": ["snapshot"] } },
    { "id": "journal.vacuum", "class": "C2", "system": true, "reversible": "none",
      "args": { "size": { "type": "string", "required": true, "pattern": "[0-9]{1,6}[KMG]" } },
      "executor": "basalt-gate-exec", "requesters": ["system-assistant"],
      "preview": { "show": ["size"] } },
    { "id": "dnf.clean", "class": "C2", "system": true, "reversible": "none",
      "args": {},
      "executor": "basalt-gate-exec", "requesters": ["system-assistant"] },
    { "id": "driver.install", "class": "C2", "system": true, "snapshot": true, "reversible": "snapshot",
      "args": { "driver": { "type": "string", "required": true, "enum": ["nvidia"] },
                "variant": { "type": "string", "required": true, "enum": ["display", "compute"] },
                "kernel": { "type": "string", "required": true, "pattern": "[0-9][0-9A-Za-z._+-]{0,100}\\.x86_64" },
                "license": { "type": "string", "required": true, "pattern": "[0-9a-f]{64}" } },
      "resources": [ { "kind": "package", "arg": "=basalt-nonfree-release" } ],
      "executor": "basalt-gate-exec", "requesters": ["system-assistant", "person"],
      "preview": { "show": ["driver", "variant", "kernel", "license"] } },
    { "id": "update.check", "class": "C0", "system": true, "reversible": "none",
      "description": "refresh the package lists (dnf makecache --refresh); nothing is installed, so basalt updates check runs it without a proposal",
      "args": {},
      "executor": "basalt-gate-exec", "requesters": ["system-assistant", "person"] },
    { "id": "update.install", "class": "C2", "system": true, "snapshot": true, "reversible": "snapshot",
      "args": { "scope": { "type": "string", "required": true, "enum": ["all", "security"] },
                "count": { "type": "string", "required": true, "pattern": "[0-9]{1,4}" },
                "packages": { "type": "string", "required": true, "max_len": 200000,
                              "pattern": "[A-Za-z0-9_.+~^:-]+( [A-Za-z0-9_.+~^:-]+)*" },
                "digest": { "type": "string", "required": true, "pattern": "[0-9a-f]{16}" } },
      "resources": [ { "kind": "package", "arg": "=updates" } ],
      "executor": "basalt-gate-exec", "requesters": ["system-assistant", "person"],
      "preview": { "show": ["scope", "count", "digest"] } },
    { "id": "update.rollback", "class": "C2", "system": true, "reversible": "snapshot",
      "args": { "snapshot": { "type": "string", "required": true, "pattern": "[0-9]{1,7}" },
                "proposal": { "type": "string", "required": true, "pattern": "p-[0-9a-f]{6}" } },
      "executor": "basalt-gate-exec", "requesters": ["system-assistant", "person"],
      "preview": { "show": ["snapshot", "proposal"] } },
    { "id": "repo.enable", "class": "C2", "system": true, "reversible": "snapshot",
      "args": { "repo": { "type": "string", "required": true, "pattern": "[a-z][a-z0-9._-]{1,62}" },
                "consent": { "type": "string", "enum": ["preview-builds-1"] },
                "definition": { "type": "string", "enum": ["install"] } },
      "resources": [ { "kind": "setting", "arg": "repo" } ],
      "executor": "basalt-gate-exec", "requesters": ["system-assistant", "person"],
      "preview": { "show": ["repo", "consent"] } },
    { "id": "repo.disable", "class": "C2", "system": true, "reversible": "snapshot",
      "args": { "repo": { "type": "string", "required": true, "pattern": "[a-z][a-z0-9._-]{1,62}" } },
      "resources": [ { "kind": "setting", "arg": "repo" } ],
      "executor": "basalt-gate-exec", "requesters": ["system-assistant", "person"],
      "preview": { "show": ["repo"] } },
    { "id": "source.add", "class": "C4", "system": true, "snapshot": true, "reversible": "snapshot",
      "description": "a new software source: its signing key becomes a trust root for the whole system",
      "args": { "id": { "type": "string", "required": true, "pattern": "[a-z][a-z0-9._-]{1,62}" },
                "name": { "type": "string", "required": true, "max_len": 120 },
                "kind": { "type": "string", "required": true, "enum": ["rpm", "flatpak"] },
                "url_type": { "type": "string", "required": true, "enum": ["baseurl", "metalink", "flatpakrepo"] },
                "url": { "type": "string", "required": true, "max_len": 1000, "pattern": "https://[A-Za-z0-9._~%/:?&=+,@$-]+" },
                "key_url": { "type": "string", "required": true, "max_len": 1000, "pattern": "embedded|https://[A-Za-z0-9._~%/:?&=+,@$-]+" },
                "fingerprint": { "type": "string", "required": true, "pattern": "[0-9A-F]{40}" },
                "gpgcheck": { "type": "string", "required": true, "enum": ["1"] },
                "repo_gpgcheck": { "type": "string", "required": true, "enum": ["0", "1"] },
                "catalog": { "type": "string", "required": true, "pattern": "[a-z][a-z0-9-]{1,40}" },
                "group": { "type": "string", "required": true, "pattern": "[a-z][a-z0-9._-]{1,62}" } },
      "resources": [ { "kind": "setting", "arg": "id" }, { "kind": "key", "arg": "fingerprint" } ],
      "executor": "basalt-gate-exec", "requesters": ["system-assistant", "person"],
      "preview": { "show": ["name", "url", "fingerprint", "catalog"] } },
    { "id": "source.remove", "class": "C2", "system": true, "snapshot": true, "reversible": "snapshot",
      "args": { "id": { "type": "string", "required": true, "pattern": "[a-z][a-z0-9._-]{1,62}" } },
      "resources": [ { "kind": "setting", "arg": "id" } ],
      "executor": "basalt-gate-exec", "requesters": ["system-assistant", "person"],
      "preview": { "show": ["id"] } },
    { "id": "keyboard.system", "class": "C2", "system": true, "reversible": "snapshot",
      "description": "the keyboard of the login screen, the text console and new accounts (localectl); people's own keyboard settings stay",
      "args": { "layouts": { "type": "string", "required": true,
                             "pattern": "[a-z][a-z0-9_-]{0,31}(\\([A-Za-z0-9][A-Za-z0-9_.+-]{0,47}\\))?(,[a-z][a-z0-9_-]{0,31}(\\([A-Za-z0-9][A-Za-z0-9_.+-]{0,47}\\))?){0,3}" },
                "options": { "type": "string", "pattern": "(|[a-z][a-z0-9_]{0,31}:[A-Za-z0-9_+.-]{1,48}(,[a-z][a-z0-9_]{0,31}:[A-Za-z0-9_+.-]{1,48}){0,15})" },
                "model": { "type": "string", "required": true, "pattern": "[a-z0-9][a-z0-9_-]{0,31}" },
                "keymap": { "type": "string", "required": true, "pattern": "[A-Za-z0-9][A-Za-z0-9_.+-]{0,63}" } },
      "resources": [ { "kind": "setting", "arg": "=keyboard" } ],
      "executor": "basalt-gate-exec", "requesters": ["system-assistant", "person"],
      "preview": { "show": ["layouts", "options", "keymap"] } },
    { "id": "audit.run", "class": "C2", "system": true, "reversible": "none",
      "description": "run the public AI audit suite on this computer as its own unprivileged account (installing basalt-audit-suite from the Basalt repositories first when install is yes); results in /var/lib/basalt-audit/RUN",
      "args": { "run": { "type": "string", "required": true, "pattern": "[0-9]{4}-[0-9]{2}-[0-9]{2}-[0-9]{6}" },
                "install": { "type": "string", "required": true, "enum": ["yes", "no"] } },
      "resources": [ { "kind": "package", "arg": "=basalt-audit-suite" } ],
      "executor": "basalt-gate-exec", "requesters": ["system-assistant", "person"],
      "preview": { "show": ["install", "run"] } },
    { "id": "risk.accept", "class": "C2", "system": true, "reversible": "snapshot",
      "description": "record that an administrator accepts a security warning (Security and Activity shows it as accepted, with who and when, and stops counting it; a problem is never hidden)",
      "args": { "item": { "type": "string", "required": true, "enum": ["encryption", "secure_boot", "tpm", "audit", "ledger"] },
                "by": { "type": "string", "required": true, "pattern": "[a-z_][a-z0-9_.-]{0,31}" } },
      "resources": [ { "kind": "setting", "arg": "item" } ],
      "executor": "basalt-gate-exec", "requesters": ["system-assistant", "person"],
      "preview": { "show": ["item", "by"] } },
    { "id": "risk.review", "class": "C2", "system": true, "reversible": "snapshot",
      "description": "forget an accepted security risk: it counts as a warning again",
      "args": { "item": { "type": "string", "required": true, "enum": ["encryption", "secure_boot", "tpm", "audit", "ledger"] } },
      "resources": [ { "kind": "setting", "arg": "item" } ],
      "executor": "basalt-gate-exec", "requesters": ["system-assistant", "person"],
      "preview": { "show": ["item"] } }
  ]
}
