{
  "registry": 1,
  "source": "basalt-agent",
  "executors": {},
  "groups": {},
  "actions": [
    {
      "id": "agent.grant.host",
      "class": "C3",
      "leaves": true,
      "system": true,
      "description": "Let one running agent session reach one more host. The person approves it; basalt-agent then runs its root helper through pkexec, which asks for an administrator (polkit, as before).",
      "args": {
        "session": {
          "type": "string",
          "required": true,
          "pattern": "s-[0-9a-f]{12}"
        },
        "host": {
          "type": "string",
          "required": true,
          "pattern": "[A-Za-z0-9.-]{1,253}(:[0-9,-]{1,64})?"
        }
      },
      "resources": [
        {
          "kind": "host",
          "arg": "host"
        }
      ],
      "executor": "requester",
      "requesters": [
        "person",
        "tool"
      ],
      "preview": {
        "show": [
          "session",
          "host"
        ]
      },
      "decide_auth": "session"
    },
    {
      "id": "agent.grant.path",
      "class": "C2",
      "system": true,
      "description": "Hand one more directory to a running native agent session. The person approves it; basalt-agent then runs its root helper through pkexec, which asks for an administrator (polkit, as before).",
      "args": {
        "session": {
          "type": "string",
          "required": true,
          "pattern": "s-[0-9a-f]{12}"
        },
        "path": {
          "type": "string",
          "required": true,
          "max_len": 4096
        }
      },
      "resources": [
        {
          "kind": "path",
          "arg": "path",
          "beneath": true,
          "expand_home": true
        }
      ],
      "executor": "requester",
      "requesters": [
        "person",
        "tool"
      ],
      "preview": {
        "show": [
          "session",
          "path"
        ]
      },
      "decide_auth": "session"
    },
    {
      "id": "agent.egress.change",
      "class": "C3",
      "leaves": true,
      "system": false,
      "description": "Add or remove a host in the person's own override of an agent profile's allowlist (their sessions only).",
      "args": {
        "profile": {
          "type": "string",
          "required": true,
          "pattern": "[a-z0-9][a-z0-9_-]{0,40}"
        },
        "op": {
          "type": "string",
          "required": true,
          "enum": [
            "add",
            "remove"
          ]
        },
        "entry": {
          "type": "string",
          "required": true,
          "pattern": "[A-Za-z0-9.*-]{1,253}(:[0-9,-]{1,64})?"
        }
      },
      "resources": [
        {
          "kind": "host",
          "arg": "entry"
        }
      ],
      "executor": "requester",
      "requesters": [
        "person",
        "tool"
      ],
      "preview": {
        "show": [
          "profile",
          "op",
          "entry"
        ]
      }
    },
    {
      "id": "agent.egress.system",
      "class": "C3",
      "leaves": true,
      "system": true,
      "description": "Add or remove a host in an agent profile's allowlist for every user (/etc/basalt-agent/profiles). The person approves it; the root helper asks for an administrator through polkit, as before.",
      "args": {
        "profile": {
          "type": "string",
          "required": true,
          "pattern": "[a-z0-9][a-z0-9_-]{0,40}"
        },
        "op": {
          "type": "string",
          "required": true,
          "enum": [
            "add",
            "remove"
          ]
        },
        "entry": {
          "type": "string",
          "required": true,
          "pattern": "[A-Za-z0-9.*-]{1,253}(:[0-9,-]{1,64})?"
        }
      },
      "resources": [
        {
          "kind": "host",
          "arg": "entry"
        }
      ],
      "executor": "requester",
      "requesters": [
        "person",
        "tool"
      ],
      "preview": {
        "show": [
          "profile",
          "op",
          "entry"
        ]
      },
      "decide_auth": "session"
    }
  ]
}
