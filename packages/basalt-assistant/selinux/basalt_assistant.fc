/var/lib/basalt-assistant(/.*)?			gen_context(system_u:object_r:basalt_assistant_var_lib_t,s0)
/var/log/basalt-assistant(/.*)?			gen_context(system_u:object_r:basalt_assistant_log_t,s0)
