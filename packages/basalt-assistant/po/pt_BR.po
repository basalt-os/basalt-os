#: internal/cli/feedback.go:103
msgid "Write your message. End it with an empty line."
msgstr "Escreva sua mensagem. Termine com uma linha vazia."

#: internal/cli/feedback.go:107
msgid "E-mail address for a reply (optional, press Enter to skip): "
msgstr "E-mail para resposta (opcional, tecle Enter para pular): "

#: internal/cli/feedback.go:132
msgid "Include this? [y/N] "
msgstr "Incluir isto? [s/N] "

#: internal/cli/feedback.go:163
#, c-format
msgid "To send exactly this report, run the same command with --yes --confirm %s instead of --preview."
msgstr "Para enviar exatamente este relatório, rode o mesmo comando com --yes --confirm %s no lugar de --preview."

#: internal/cli/feedback.go:168
msgid "The confirmation code does not match this report. Nothing was sent. Run the command with --preview to see the report and its code."
msgstr "O código de confirmação não corresponde a este relatório. Nada foi enviado. Rode o comando com --preview para ver o relatório e o código dele."

#: internal/cli/feedback.go:179
msgid "Send it? Type yes to send, edit to change it, or press Enter to cancel: "
msgstr "Enviar? Digite sim para enviar, editar para mudar, ou tecle Enter para cancelar: "

#: internal/cli/feedback.go:183
msgid "edit"
msgstr "editar"

#: internal/cli/feedback.go:185
#, c-format
msgid "The report could not be changed: %v"
msgstr "Não foi possível mudar o relatório: %v"

#: internal/cli/feedback.go:189 internal/cli/feedback.go:220
msgid "Nothing was sent."
msgstr "Nada foi enviado."

#: internal/cli/feedback.go:206
msgid "What is it about?"
msgstr "Do que se trata?"

#: internal/cli/feedback.go:207
msgid "something is broken"
msgstr "algo não funciona"

#: internal/cli/feedback.go:208
msgid "an idea"
msgstr "uma ideia"

#: internal/cli/feedback.go:209
msgid "something else"
msgstr "outra coisa"

#: internal/cli/feedback.go:210
msgid "Choose 1, 2 or 3: "
msgstr "Escolha 1, 2 ou 3: "

#: internal/cli/feedback.go:227
msgid "The Basalt OS version and the kernel release:"
msgstr "A versão do Basalt OS e a versão do kernel:"

#: internal/cli/feedback.go:229
msgid "The versions of the installed basalt-* packages:"
msgstr "As versões dos pacotes basalt-* instalados:"

#: internal/cli/feedback.go:231
msgid "A hardware summary (processor, memory, firmware, virtual machine or not, TPM), nothing that identifies the machine:"
msgstr "Um resumo do hardware (processador, memória, firmware, máquina virtual ou não, TPM), nada que identifique a máquina:"

#: internal/cli/feedback.go:233
msgid "The assistant's findings of the last 7 days:"
msgstr "Os achados do assistente nos últimos 7 dias:"

#: internal/cli/feedback.go:243
#, c-format
msgid "The system version could not be read: %v"
msgstr "Não foi possível ler a versão do sistema: %v"

#: internal/cli/feedback.go:251
msgid "No basalt-* packages were found."
msgstr "Nenhum pacote basalt-* foi encontrado."

#: internal/cli/feedback.go:264
msgid "No findings of the assistant are readable here. They are in the system journal; run sudo basalt feedback to include them."
msgstr "Nenhum achado do assistente pode ser lido aqui. Eles ficam no journal do sistema; rode sudo basalt feedback para incluí-los."

#: internal/cli/feedback.go:266
msgid "The assistant has no findings from the last 7 days."
msgstr "O assistente não tem achados dos últimos 7 dias."

#: internal/cli/feedback.go:305
#, c-format
msgid "This is exactly what will be sent to %s:"
msgstr "Isto é exatamente o que será enviado para %s:"

#: internal/cli/feedback.go:308
#, c-format
msgid "%d value was changed to hide personal data (shown as [redacted])."
msgid_plural "%d values were changed to hide personal data (shown as [redacted])."
msgstr[0] "%d valor foi mudado para esconder dados pessoais (aparece como [redacted])."
msgstr[1] "%d valores foram mudados para esconder dados pessoais (aparecem como [redacted])."

#: internal/cli/feedback.go:312
msgid "Your e-mail address is sent as you typed it, so the project can reply."
msgstr "Seu e-mail é enviado como você digitou, para que o projeto possa responder."

#: internal/cli/feedback.go:314
msgid "The service keeps the report and the time it arrived; it does not keep your IP address."
msgstr "O serviço guarda o relatório e a hora em que chegou; ele não guarda seu endereço IP."

#: internal/cli/feedback.go:324
#, c-format
msgid "The feedback service could not be reached: %v. Nothing was sent; you can write to feedback@basalt-os.org instead."
msgstr "Não foi possível falar com o serviço de feedback: %v. Nada foi enviado; você pode escrever para feedback@basalt-os.org."

#: internal/cli/feedback.go:331
#, c-format
msgid "Sent. Thank you. Reference: %s"
msgstr "Enviado. Obrigado. Referência: %s"

#: internal/cli/feedback.go:343
msgid "The message is empty. Nothing was sent."
msgstr "A mensagem está vazia. Nada foi enviado."

#: internal/cli/feedback.go:345
#, c-format
msgid "The message is longer than %d characters. Nothing was sent."
msgstr "A mensagem tem mais de %d caracteres. Nada foi enviado."

#: internal/cli/feedback.go:347
msgid "The e-mail address does not look right. Nothing was sent."
msgstr "O endereço de e-mail não parece correto. Nada foi enviado."

#: internal/cli/feedback.go:349
msgid "The kind must be bug, idea or other. Nothing was sent."
msgstr "O tipo deve ser bug, idea ou other. Nada foi enviado."

#: internal/cli/feedback.go:351
msgid "The system details are too large to send; leave out a part. Nothing was sent."
msgstr "Os detalhes do sistema são grandes demais para enviar; deixe uma parte de fora. Nada foi enviado."

#: internal/cli/feedback.go:353
msgid "The feedback service received too many reports from your network in the last hour. Nothing was sent; please try again later."
msgstr "O serviço de feedback recebeu relatórios demais da sua rede na última hora. Nada foi enviado; tente de novo mais tarde."

#: internal/cli/feedback.go:355
msgid "The feedback service received a lot of reports today. Nothing was sent; please try again tomorrow, or write to feedback@basalt-os.org."
msgstr "O serviço de feedback recebeu muitos relatórios hoje. Nada foi enviado; tente de novo amanhã, ou escreva para feedback@basalt-os.org."

#: internal/cli/feedback.go:357
#, c-format
msgid "The feedback service refused the report (%s). Nothing was sent; you can write to feedback@basalt-os.org instead."
msgstr "O serviço de feedback recusou o relatório (%s). Nada foi enviado; você pode escrever para feedback@basalt-os.org."

#: internal/cli/feedback.go:443
msgid "y"
msgstr "s"

#: internal/apply/apply.go:83 internal/cli/feedback.go:447
msgid "yes"
msgstr "sim"

#: internal/cli/feedback.go:66
msgid "Sending feedback is turned off on this system ([feedback] endpoint is empty in /etc/basalt/assistant.conf). You can write to feedback@basalt-os.org instead."
msgstr "O envio de feedback está desligado neste sistema ([feedback] endpoint está vazio em /etc/basalt/assistant.conf). Você pode escrever para feedback@basalt-os.org."

#: internal/cli/feedback.go:90 internal/cli/feedback.go:174
msgid "Without a terminal, give the message and --kind, choose the parts with --include, look at the report with --preview and send it with --yes --confirm CODE."
msgstr "Sem um terminal, informe a mensagem e --kind, escolha as partes com --include, veja o relatório com --preview e envie com --yes --confirm CÓDIGO."

#: internal/cli/feedback.go:94
msgid "Send feedback to the Basalt OS project."
msgstr "Enviar feedback ao projeto Basalt OS."

#: internal/cli/feedback.go:95
msgid "Nothing leaves this computer until you have seen exactly what will be sent and said yes."
msgstr "Nada sai deste computador antes de você ver exatamente o que será enviado e dizer sim."

#: internal/cli/drivers.go:136
msgid "Graphics hardware"
msgstr "Placas de vídeo"

#: internal/cli/drivers.go:138
msgid "No display controller was found."
msgstr "Nenhuma placa de vídeo foi encontrada."

#: internal/cli/drivers.go:146
#, c-format
msgid "driver now: %s"
msgstr "driver atual: %s"

#: internal/cli/drivers.go:148
msgid "shows the boot screen"
msgstr "mostra a tela de inicialização"

#: internal/cli/drivers.go:156
#, c-format
msgid "Recommended: the NVIDIA driver %s (proprietary) for %s."
msgstr "Recomendado: o driver NVIDIA %s (proprietário) para %s."

#: internal/cli/drivers.go:157
msgid "What changes if you install it:"
msgstr "O que muda se você instalar:"

#: internal/cli/drivers.go:161
#, c-format
msgid "Packages: %s"
msgstr "Pacotes: %s"

#: internal/cli/drivers.go:163
#, c-format
msgid "The NVIDIA driver %s is installed (%s)."
msgstr "O driver NVIDIA %s está instalado (%s)."

#: internal/cli/drivers.go:165
#, c-format
msgid "The NVIDIA driver %s is installed but switched off since %s: %s. nouveau is used."
msgstr "O driver NVIDIA %s está instalado, mas desligado desde %s: %s. O nouveau está em uso."

#: internal/cli/drivers.go:167
msgid "Driver installation is coming soon: the basalt-nonfree repository is not published yet."
msgstr "A instalação de drivers chega em breve: o repositório basalt-nonfree ainda não foi publicado."

#: internal/cli/drivers.go:169
msgid "No NVIDIA GPU: the drivers already installed are the right ones."
msgstr "Nenhuma GPU NVIDIA: os drivers já instalados são os certos."

#: internal/cli/drivers.go:175
msgid "Before installing:"
msgstr "Antes de instalar:"

#: internal/cli/drivers.go:183
msgid "in use"
msgstr "em uso"

#: internal/cli/drivers.go:181
msgid "waiting for the first start to check it"
msgstr "aguardando a primeira inicialização para verificá-lo"

#: internal/cli/drivers.go:187
msgid "not set up"
msgstr "não configurado"

#: internal/cli/drivers.go:185
msgid "off, nouveau is used"
msgstr "desligado, o nouveau está em uso"

#: internal/cli/drivers.go:189
#, c-format
msgid "State: %s."
msgstr "Estado: %s."

#: internal/cli/drivers.go:191
#, c-format
msgid "This start uses: %s %s"
msgstr "Esta inicialização usa: %s %s"

#: internal/cli/drivers.go:194
#, c-format
msgid "Kernel %s waits for its NVIDIA module; the computer keeps starting an older kernel."
msgstr "O kernel %s aguarda o seu módulo NVIDIA; o computador continua iniciando um kernel anterior."

#: internal/cli/drivers.go:197
#, c-format
msgid "Secure Boot: %s."
msgstr "Secure Boot: %s."

#: internal/cli/drivers.go:205
msgid "Read the license: basalt drivers license nvidia"
msgstr "Leia a licença: basalt drivers license nvidia"

#: internal/cli/drivers.go:206
msgid "Install it: sudo basalt drivers install nvidia --apply"
msgstr "Instale: sudo basalt drivers install nvidia --apply"

#: internal/cli/drivers.go:209
msgid "Return to the snapshot taken before the install: sudo basalt drivers rollback --apply"
msgstr "Volte ao snapshot de antes da instalação: sudo basalt drivers rollback --apply"

#: internal/cli/drivers.go:210
msgid "Try the NVIDIA driver again at the next start: sudo basalt-nvidia retry"
msgstr "Tente o driver NVIDIA de novo na próxima inicialização: sudo basalt-nvidia retry"

#: internal/cli/drivers.go:212
#, c-format
msgid "More: %s"
msgstr "Mais: %s"

#: internal/cli/drivers.go:99
msgid "No snapshot from before the NVIDIA driver install is known on this system."
msgstr "Nenhum snapshot de antes da instalação do driver NVIDIA é conhecido neste sistema."

#: internal/titles/titles.go:100
msgid "crashed"
msgstr "travou"

#: internal/titles/titles.go:101
msgid "keeps crashing"
msgstr "trava repetidamente"

#: internal/titles/titles.go:102
msgid "out of memory"
msgstr "sem memória"

#: internal/titles/titles.go:103
msgid "file permissions"
msgstr "permissões de arquivo"

#: internal/titles/titles.go:104
msgid "no such unit"
msgstr "unidade inexistente"

#: internal/titles/titles.go:105
msgid "cause unknown"
msgstr "causa desconhecida"

#: internal/titles/titles.go:106
msgid "wrong file label"
msgstr "rótulo de arquivo errado"

#: internal/titles/titles.go:107
msgid "no label rule for this place"
msgstr "nenhuma regra de rótulo para este lugar"

#: internal/titles/titles.go:108
msgid "port not labeled for it"
msgstr "porta sem rótulo para ele"

#: internal/titles/titles.go:109
msgid "a boolean is off"
msgstr "um booleano está desligado"

#: internal/titles/titles.go:110
msgid "no known fix"
msgstr "nenhuma correção conhecida"

#: internal/titles/titles.go:111
msgid "looks deliberate"
msgstr "parece proposital"

#: internal/titles/titles.go:112
msgid "snapshots hold the space"
msgstr "os snapshots ocupam o espaço"

#: internal/titles/titles.go:113
msgid "large journal"
msgstr "journal grande"

#: internal/titles/titles.go:114
msgid "large package cache"
msgstr "cache de pacotes grande"

#: internal/titles/titles.go:115
msgid "data"
msgstr "dados"

#: internal/titles/titles.go:116
#, c-format
msgid "%s updates"
msgstr "%s atualizações"

#: internal/titles/titles.go:117
#, c-format
msgid "%s security updates"
msgstr "%s atualizações de segurança"

#: internal/titles/titles.go:30
#, c-format
msgid "%s stopped: %s"
msgstr "%s parou: %s"

#: internal/titles/titles.go:31
#, c-format
msgid "%s is running"
msgstr "%s está rodando"

#: internal/titles/titles.go:32
#, c-format
msgid "SELinux blocked %s (%s) on %s: %s"
msgstr "O SELinux bloqueou %s (%s) em %s: %s"

#: internal/titles/titles.go:33
#, c-format
msgid "root file system %.0f %% full: %s"
msgstr "sistema de arquivos raiz %.0f %% cheio: %s"

#: internal/titles/titles.go:34
#, c-format
msgid "root file system %.0f %% full"
msgstr "sistema de arquivos raiz %.0f %% cheio"

#: internal/titles/titles.go:35
#, c-format
msgid "package transaction failed: %s"
msgstr "a transação de pacotes falhou: %s"

#: internal/titles/titles.go:36
#, c-format
msgid "roll back to snapshot %d (%s, \"%s\")"
msgstr "voltar ao snapshot %d (%s, \"%s\")"

#: internal/titles/titles.go:37
#, c-format
msgid "Applying \"%s\" did not finish"
msgstr "Aplicar \"%s\" não terminou"

#: internal/titles/titles.go:38
msgid "Applying a change you confirmed did not finish"
msgstr "Aplicar uma mudança que você confirmou não terminou"

#: internal/titles/titles.go:39
#, c-format
msgid "Applying the change %s did not finish"
msgstr "Aplicar a mudança %s não terminou"

#: internal/titles/titles.go:41
#, c-format
msgid "install %d updates (%s to download)"
msgstr "instalar %d atualizações (%s para baixar)"

#: internal/titles/titles.go:42
#, c-format
msgid "install %d security updates (%s to download)"
msgstr "instalar %d atualizações de segurança (%s para baixar)"

#: internal/titles/titles.go:43
#, c-format
msgid "restart and install %d updates (%s to download)"
msgstr "reiniciar e instalar %d atualizações (%s para baixar)"

#: internal/titles/titles.go:44
#, c-format
msgid "restart and install %d security updates (%s to download)"
msgstr "reiniciar e instalar %d atualizações de segurança (%s para baixar)"

#: internal/titles/titles.go:45
#, c-format
msgid "undo the update %s: back to snapshot %d"
msgstr "desfazer a atualização %s: voltar ao snapshot %d"

#: internal/titles/titles.go:46
#, c-format
msgid "install the NVIDIA driver %s for %s"
msgstr "instalar o driver NVIDIA %s para %s"

#: internal/explain/prose.go:587 internal/titles/titles.go:48
#, c-format
msgid "turn the %s channel on"
msgstr "ligar o canal %s"

#: internal/explain/prose.go:589 internal/titles/titles.go:49
#, c-format
msgid "turn the %s channel off"
msgstr "desligar o canal %s"

#: internal/titles/titles.go:50
#, c-format
msgid "add the software source %s"
msgstr "adicionar a fonte de software %s"

#: internal/explain/prose.go:593 internal/titles/titles.go:51
#, c-format
msgid "remove the software source %s"
msgstr "remover a fonte de software %s"

#: internal/titles/titles.go:52
#, c-format
msgid "use %s for the login screen, the console and new accounts"
msgstr "usar %s na tela de login, no console e nas contas novas"

#: internal/explain/prose.go:600 internal/titles/titles.go:53
msgid "run the AI audit suite on this computer"
msgstr "rodar a suíte de auditoria de IA neste computador"

#: internal/titles/titles.go:54
#, c-format
msgid "accept the risk of %s"
msgstr "aceitar o risco de %s"

#: internal/titles/titles.go:55
#, c-format
msgid "review the risk of %s again"
msgstr "rever o risco de %s"

#: internal/titles/titles.go:57
#, c-format
msgid "label %s and everything below it %s (persistent rule)"
msgstr "rotular %s e tudo abaixo dele como %s (regra permanente)"

#: internal/titles/titles.go:58
msgid "apply the rule to the existing files"
msgstr "aplicar a regra aos arquivos existentes"

#: internal/titles/titles.go:59
#, c-format
msgid "reset the label of %s to the policy default"
msgstr "restaurar o rótulo de %s para o padrão da política"

#: internal/titles/titles.go:60
#, c-format
msgid "label %s port %s %s"
msgstr "rotular a porta %s %s como %s"

#: internal/titles/titles.go:61
#, c-format
msgid "set the boolean %s %s (persistent)"
msgstr "definir o booleano %s como %s (permanente)"

#: internal/explain/prose.go:564 internal/titles/titles.go:62
#, c-format
msgid "restart %s"
msgstr "reiniciar %s"

#: internal/titles/titles.go:63
#, c-format
msgid "restore %s from snapshot %s"
msgstr "restaurar %s do snapshot %s"

#: internal/titles/titles.go:64
msgid "label the restored file"
msgstr "rotular o arquivo restaurado"

#: internal/titles/titles.go:65
#, c-format
msgid "make snapshot %s the root at the next boot (data subvolumes untouched)"
msgstr "fazer do snapshot %s a raiz na próxima inicialização (subvolumes de dados intactos)"

#: internal/titles/titles.go:66
#, c-format
msgid "delete snapshot %s and free the space only it holds"
msgstr "apagar o snapshot %s e liberar o espaço que só ele ocupa"

#: internal/titles/titles.go:67
#, c-format
msgid "shrink archived journal files to %s"
msgstr "reduzir os arquivos arquivados do journal para %s"

#: internal/titles/titles.go:68
msgid "remove cached package files"
msgstr "remover os pacotes guardados em cache"

#: internal/titles/titles.go:69
msgid "install the definition of the basalt-nonfree repository (it comes off)"
msgstr "instalar a definição do repositório basalt-nonfree (ele vem desligado)"

#: internal/titles/titles.go:70
msgid "turn the basalt-nonfree repository on"
msgstr "ligar o repositório basalt-nonfree"

#: internal/titles/titles.go:71
#, c-format
msgid "install %s (NVIDIA's userspace, unmodified, and the signed open kernel modules; nouveau goes off) and the module for the running kernel %s"
msgstr "instalar %s (o espaço de usuário da NVIDIA, sem modificações, e os módulos abertos do kernel assinados; o nouveau é desligado) e o módulo para o kernel em uso %s"

#: internal/titles/titles.go:72
msgid "make the next start a trial: it checks the driver and goes back to nouveau if it fails"
msgstr "fazer da próxima inicialização um teste: ela confere o driver e volta ao nouveau se ele falhar"

#: internal/titles/titles.go:73
msgid "download the newest list of packages from every enabled repository (nothing is installed)"
msgstr "baixar a lista mais nova de pacotes de cada repositório ligado (nada é instalado)"

#: internal/titles/titles.go:74
#, c-format
msgid "download %s (checked against the repositories' signing keys) and prepare them to install at the next start"
msgstr "baixar %s (conferidas com as chaves de assinatura dos repositórios) e preparar a instalação na próxima inicialização"

#: internal/titles/titles.go:75
msgid "restart into them (after the desktop's countdown, or sudo basalt updates restart): they install before the desktop starts"
msgstr "reiniciar para elas (depois da contagem regressiva da área de trabalho, ou sudo basalt updates restart): elas se instalam antes de a área de trabalho abrir"

#: internal/titles/titles.go:76
#, c-format
msgid "download %s (checked against the repositories' signing keys)"
msgstr "baixar %s (conferidas com as chaves de assinatura dos repositórios)"

#: internal/titles/titles.go:77
#, c-format
msgid "install %s, exactly the versions shown"
msgstr "instalar %s, exatamente as versões mostradas"

#: internal/titles/titles.go:78
#, c-format
msgid "undo the update %s: make snapshot %s, taken just before it, the root at the next boot (your files untouched)"
msgstr "desfazer a atualização %s: fazer do snapshot %s, tirado logo antes dela, a raiz na próxima inicialização (seus arquivos intactos)"

#: internal/titles/titles.go:79
msgid "install the definition of the basalt-nonfree channels (they come off)"
msgstr "instalar a definição dos canais basalt-nonfree (eles vêm desligados)"

#: internal/titles/titles.go:80
msgid "bring that definition up to date (it gains the testing channel)"
msgstr "atualizar essa definição (ela ganha o canal de testes)"

#: internal/titles/titles.go:81
#, c-format
msgid "add the source %s (%s), trusting its signing key %s after checking it again"
msgstr "adicionar a fonte %s (%s), confiando na chave de assinatura %s depois de conferi-la de novo"

#: internal/titles/titles.go:82
#, c-format
msgid "remove the source %s (and its key, when no other repository of it is left)"
msgstr "remover a fonte %s (e a chave dela, quando não sobrar outro repositório dela)"

#: internal/titles/titles.go:83
#, c-format
msgid "make %s the keyboard layouts of the login screen and of new accounts"
msgstr "fazer de %s os layouts de teclado da tela de login e das contas novas"

#: internal/titles/titles.go:84
#, c-format
msgid "use the keymap %s in the text console"
msgstr "usar o mapa de teclas %s no console de texto"

#: internal/titles/titles.go:85
#, c-format
msgid "install the AI audit suite (%s) from the Basalt repositories, checked against their signing key"
msgstr "instalar a suíte de auditoria de IA (%s) dos repositórios do Basalt, conferida com a chave de assinatura deles"

#: internal/titles/titles.go:86
#, c-format
msgid "run the AI audit suite on this computer, as its own unprivileged account, and keep the results in %s"
msgstr "rodar a suíte de auditoria de IA neste computador, com a conta sem privilégios dela, e guardar os resultados em %s"

#: internal/titles/titles.go:87
#, c-format
msgid "record that %s accepts the risk of %s on this computer (%s)"
msgstr "registrar que %s aceita o risco de %s neste computador (%s)"

#: internal/titles/titles.go:88
#, c-format
msgid "forget the accepted risk of %s: it shows as a warning again"
msgstr "esquecer o risco aceito de %s: ele volta a aparecer como aviso"

#: internal/titles/titles.go:94
msgid "configuration error"
msgstr "erro de configuração"

#: internal/titles/titles.go:95
msgid "blocked by SELinux"
msgstr "bloqueado pelo SELinux"

#: internal/titles/titles.go:96
msgid "port already in use"
msgstr "porta já em uso"

#: internal/titles/titles.go:97
msgid "a unit it needs failed"
msgstr "uma unidade de que ela precisa falhou"

#: internal/titles/titles.go:98
msgid "disk full"
msgstr "disco cheio"

#: internal/titles/titles.go:99
msgid "missing file"
msgstr "arquivo faltando"

#: internal/apply/apply.go:132
msgid "a snapshot is taken before and after"
msgstr "um snapshot é tirado antes e depois"

#: internal/apply/apply.go:134
msgid "no extra snapshot: the rollback works on snapshots itself"
msgstr "sem snapshot extra: o rollback já trabalha com snapshots"

#: internal/apply/apply.go:136
msgid "no snapshot: the system's keyboard is one setting, and choosing other layouts changes it back"
msgstr "sem snapshot: o teclado do sistema é uma configuração só, e escolher outros layouts a desfaz"

#: internal/apply/apply.go:138
msgid "no snapshot: an accepted risk is one setting, and Review again changes it back"
msgstr "sem snapshot: um risco aceito é uma configuração só, e Revisar de novo a desfaz"

#: internal/apply/apply.go:140
msgid "no snapshot: turning a channel on or off changes one setting, and the next update takes its own snapshot"
msgstr "sem snapshot: ligar ou desligar um canal muda uma configuração só, e a próxima atualização tira o próprio snapshot"

#: internal/apply/apply.go:142
msgid "the command shown above"
msgstr "o comando mostrado acima"

#: internal/apply/apply.go:144
#, c-format
msgid "the %d commands shown above, in that order"
msgstr "os %d comandos mostrados acima, nessa ordem"

#: internal/apply/apply.go:146
#, c-format
msgid "Applying runs %s, as root (%s)."
msgstr "Aplicar roda %s, como root (%s)."

#: internal/apply/apply.go:164
msgid "Type yes to apply it, or anything else to cancel: "
msgstr "Digite sim para aplicar, ou qualquer outra coisa para cancelar: "

#: internal/apply/apply.go:218
#, c-format
msgid "Snapshot %d taken (before the change)."
msgstr "Snapshot %d tirado (antes da mudança)."

#: internal/apply/apply.go:220
#, c-format
msgid "Warning: no snapshot could be taken before the change: %v"
msgstr "Aviso: não foi possível tirar um snapshot antes da mudança: %v"

#: internal/apply/apply.go:240
#, c-format
msgid "That command failed (exit code %d), so the remaining ones were not run."
msgstr "Esse comando falhou (código de saída %d), então os demais não foram rodados."

#: internal/apply/apply.go:250
#, c-format
msgid "Snapshot %d taken (after the change)."
msgstr "Snapshot %d tirado (depois da mudança)."

#: internal/apply/apply.go:260
msgid "Checking that it worked"
msgstr "Conferindo se funcionou"

#: internal/apply/apply.go:288
#, c-format
msgid "Warning: the boot will not finish the record: %v"
msgstr "Aviso: a inicialização não vai concluir o registro: %v"

#: internal/apply/apply.go:299 internal/apply/offline.go:133
#, c-format
msgid "Warning: could not update the proposal: %v"
msgstr "Aviso: não foi possível atualizar a proposta: %v"

#: internal/apply/apply.go:302
#, c-format
msgid "Ready: %s installs at the next start (audit record #%d)."
msgstr "Pronto: %s será instalada na próxima inicialização (registro de auditoria #%d)."

#: internal/apply/apply.go:303
msgid "Restart to install it: Settings, Updates and channels, or sudo basalt updates restart"
msgstr "Reinicie para instalar: Configurações, Atualizações e canais, ou sudo basalt updates restart"

#: internal/apply/apply.go:305
#, c-format
msgid "Done: %s is applied and every check passed (audit record #%d)."
msgstr "Feito: %s foi aplicada e todas as verificações passaram (registro de auditoria #%d)."

#: internal/apply/apply.go:310
#, c-format
msgid "%s did not work as expected: see the failed step or check above (audit record #%d)."
msgstr "%s não funcionou como esperado: veja acima o passo ou a verificação que falhou (registro de auditoria #%d)."

#: internal/apply/apply.go:341
#, c-format
msgid "warning: audit log: %v"
msgstr "aviso: log de auditoria: %v"

#: internal/apply/apply.go:433
#, c-format
msgid "To undo it: %s   (back to snapshot %d, at the next boot)"
msgstr "Para desfazer: %s   (volta ao snapshot %d, na próxima inicialização)"

#: internal/apply/apply.go:463
#, c-format
msgid "That command failed (exit code %d). The update stays prepared."
msgstr "Esse comando falhou (código de saída %d). A atualização continua preparada."

#: internal/apply/apply.go:89 internal/cli/cli.go:1044
msgid "ok"
msgstr "ok"

#: internal/apply/apply.go:91
msgid "FAIL"
msgstr "FALHOU"

#: internal/apply/gate.go:101
#, c-format
msgid "basalt-gate-exec applies it now (%s shows its output)."
msgstr "O basalt-gate-exec aplica agora (%s mostra a saída)."

#: internal/apply/gate.go:132
#, c-format
msgid "Done: %s is applied and every check passed."
msgstr "Feito: %s foi aplicada e todas as verificações passaram."

#: internal/apply/gate.go:141
#, c-format
msgid "the rule %s"
msgstr "a regra %s"

#: internal/apply/gate.go:143
#, c-format
msgid "a person (%s)"
msgstr "uma pessoa (%s)"

#: internal/apply/gate.go:36
#, c-format
msgid "Approved by %s."
msgstr "Aprovada por %s."

#: internal/apply/gate.go:63
#, c-format
msgid "Type yes to apply it, or anything else to cancel (request %s, code %s): "
msgstr "Digite sim para aplicar, ou qualquer outra coisa para cancelar (pedido %s, código %s): "

#: internal/apply/gate.go:73
#, c-format
msgid "Waiting for a decision in the approval queue (request %s, code %s): approve it in the desktop shell or with %s."
msgstr "Aguardando uma decisão na fila de aprovação (pedido %s, código %s): aprove no shell da área de trabalho ou com %s."

#: internal/apply/offline.go:107
#, c-format
msgid "Snapshot %d taken (after the update)."
msgstr "Snapshot %d tirado (depois da atualização)."

#: internal/apply/offline.go:139
#, c-format
msgid "%s: %s (snapshots %s before, %s after)"
msgstr "%s: %s (snapshots %s antes, %s depois)"

#: internal/apply/offline.go:96
#, c-format
msgid "%s is still staged: it installs when the computer restarts into it."
msgstr "%s continua preparada: ela é instalada quando o computador reiniciar para ela."

#: internal/cli/cli.go:1046
msgid "FAILED"
msgstr "FALHOU"

#: internal/cli/cli.go:1056
#, c-format
msgid "%d hour"
msgid_plural "%d hours"
msgstr[0] "%d hora"
msgstr[1] "%d horas"

#: internal/cli/cli.go:1059
#, c-format
msgid "%d minute"
msgid_plural "%d minutes"
msgstr[0] "%d minuto"
msgstr[1] "%d minutos"

#: internal/cli/cli.go:380
msgid "This is a preview. Run the same command with sudo to store the proposal and apply it."
msgstr "Isto é uma prévia. Rode o mesmo comando com sudo para guardar a proposta e aplicá-la."

#: internal/cli/cli.go:526
#, c-format
msgid "SELinux blocked nothing in the last %s. Nothing to do."
msgstr "O SELinux não bloqueou nada no período de %s até agora. Nada a fazer."

#: internal/cli/cli.go:529
#, c-format
msgid "SELinux blocked %d kind of access in the last %s. Each one is explained below."
msgid_plural "SELinux blocked %d kinds of access in the last %s. Each one is explained below."
msgstr[0] "O SELinux bloqueou %d tipo de acesso no período de %s até agora. Cada um é explicado abaixo."
msgstr[1] "O SELinux bloqueou %d tipos de acesso no período de %s até agora. Cada um é explicado abaixo."

#: internal/cli/cli.go:605
#, c-format
msgid "Checked as root. The hint %s is closed and stored as proposal %s, which you can apply."
msgstr "Conferido como root. A dica %s foi fechada e guardada como a proposta %s, que você pode aplicar."

#: internal/cli/cli.go:783
msgid "There are no proposals."
msgstr "Não há propostas."

#: internal/cli/cli.go:785
msgid "Nothing is waiting for your decision."
msgstr "Nada está aguardando sua decisão."

#: internal/cli/cli.go:793
msgid "[review]: the assistant is not sure, read it first. [hint]: confirm it as root first. [report]: nothing to apply."
msgstr "[revisar]: o assistente não tem certeza, leia antes. [dica]: confirme como root primeiro. [relatório]: nada a aplicar."

#: internal/cli/cli.go:794
msgid "Details: basalt show ID.   Then: sudo basalt apply ID, or sudo basalt ignore ID."
msgstr "Detalhes: basalt show ID.   Depois: sudo basalt apply ID, ou sudo basalt ignore ID."

#: internal/cli/cli.go:868
msgid "it worked and every check passed"
msgstr "funcionou e todas as verificações passaram"

#: internal/cli/cli.go:870
msgid "it did NOT verify"
msgstr "NÃO passou na verificação"

#: internal/cli/cli.go:872
#, c-format
msgid "Applied on %s UTC: %s (snapshots %d before, %d after; audit record #%d)"
msgstr "Aplicada em %s UTC: %s (snapshots %d antes, %d depois; registro de auditoria #%d)"

#: internal/cli/cli.go:957
#, c-format
msgid "%s is closed without changing anything (recorded in the audit log)."
msgstr "%s foi fechada sem mudar nada (registrado no log de auditoria)."

#: internal/explain/prose.go:126
msgid "24 hours"
msgstr "24 horas"

#: internal/explain/prose.go:129
#, c-format
msgid "%s days"
msgstr "%s dias"

#: internal/explain/prose.go:140
#, c-format
msgid "%s is running normally."
msgstr "%s está rodando normalmente."

#: internal/explain/prose.go:141 internal/explain/prose.go:389
msgid "Nothing to do."
msgstr "Nada a fazer."

#: internal/explain/prose.go:146
#, c-format
msgid "There is no unit called %s on this system."
msgstr "Não existe uma unidade chamada %s neste sistema."

#: internal/explain/prose.go:147
msgid "Check the name; systemctl list-units shows the units that exist."
msgstr "Confira o nome; systemctl list-units mostra as unidades que existem."

#: internal/explain/prose.go:149
msgid "its configuration"
msgstr "sua configuração"

#: internal/explain/prose.go:153
#, c-format
msgid "%s (line %s)"
msgstr "%s (linha %s)"

#: internal/explain/prose.go:156
#, c-format
msgid "%s is not running because of a mistake in %s."
msgstr "%s não está rodando por causa de um erro em %s."

#: internal/explain/prose.go:160
#, c-format
msgid "The configuration check %s says: %s."
msgstr "A verificação de configuração %s diz: %s."

#: internal/explain/prose.go:162
#, c-format
msgid "The service log says: %s."
msgstr "O log do serviço diz: %s."

#: internal/explain/prose.go:166
msgid "The background service cannot look inside snapshots, so confirm it as root: the assistant then tests the snapshot copy with the configuration check before proposing it."
msgstr "O serviço em segundo plano não consegue olhar dentro dos snapshots, então confirme como root: o assistente testa a cópia do snapshot com a verificação de configuração antes de propor."

#: internal/explain/prose.go:170
#, c-format
msgid "No snapshot has a working copy of the file, so fix it by hand and then restart %s."
msgstr "Nenhum snapshot tem uma cópia boa do arquivo, então corrija-o à mão e depois reinicie %s."

#: internal/explain/prose.go:174
#, c-format
msgid "%s is not running because SELinux blocked something it needs."
msgstr "%s não está rodando porque o SELinux bloqueou algo de que ela precisa."

#: internal/explain/prose.go:178
msgid "There is no safe automatic fix for at least one denial, so it needs a person to review it."
msgstr "Não há correção automática segura para pelo menos uma negação, então uma pessoa precisa revisar."

#: internal/explain/prose.go:182
#, c-format
msgid "%s cannot start because another program is already using its port."
msgstr "%s não consegue iniciar porque outro programa já está usando a porta dela."

#: internal/explain/prose.go:185
#, c-format
msgid "Port %s is held by %s."
msgstr "A porta %s está ocupada por %s."

#: internal/explain/prose.go:187
#, c-format
msgid "Port %s is already in use."
msgstr "A porta %s já está em uso."

#: internal/explain/prose.go:189
#, c-format
msgid "Stop the other program or give %s a different port. Nothing is changed automatically."
msgstr "Pare o outro programa ou dê outra porta a %s. Nada é alterado automaticamente."

#: internal/explain/prose.go:192
#, c-format
msgid "%s did not start because a unit it depends on failed."
msgstr "%s não iniciou porque uma unidade de que ela depende falhou."

#: internal/explain/prose.go:198
#, c-format
msgid "%s has failed."
msgstr "%s falhou."

#: internal/explain/prose.go:200
#, c-format
msgid "%s is inactive."
msgstr "%s está inativa."

#: internal/explain/prose.go:202
#, c-format
msgid "%s is activating."
msgstr "%s ainda está iniciando."

#: internal/explain/prose.go:204
#, c-format
msgid "%s is deactivating."
msgstr "%s está parando."

#: internal/explain/prose.go:206
#, c-format
msgid "%s is %s."
msgstr "%s está %s."

#: internal/explain/prose.go:208
#, c-format
msgid "Fix %s first; %s can start once it runs."
msgstr "Corrija %s primeiro; %s consegue iniciar quando ela estiver rodando."

#: internal/explain/prose.go:211
#, c-format
msgid "%s failed while the disk was full."
msgstr "%s falhou enquanto o disco estava cheio."

#: internal/explain/prose.go:213
#, c-format
msgid "%s is %s %% full."
msgstr "%s está %s %% cheio."

#: internal/explain/prose.go:215
msgid "Free some space first; the disk report shows what is using it."
msgstr "Libere espaço primeiro; o relatório de disco mostra o que está ocupando."

#: internal/explain/prose.go:217
#, c-format
msgid "%s failed because a file it needs does not exist."
msgstr "%s falhou porque um arquivo de que ela precisa não existe."

#: internal/explain/prose.go:219
#, c-format
msgid "Its log says: %s."
msgstr "O log dela diz: %s."

#: internal/explain/prose.go:221
#, c-format
msgid "Create or restore the missing file, then start %s again."
msgstr "Crie ou restaure o arquivo que falta e depois inicie %s de novo."

#: internal/explain/prose.go:224
#, c-format
msgid "%s ran out of memory and was stopped by the kernel."
msgstr "%s ficou sem memória e foi parada pelo kernel."

#: internal/explain/prose.go:227
#, c-format
msgid "It reached its memory limit (MemoryMax=%s)."
msgstr "Ela atingiu o limite de memória (MemoryMax=%s)."

#: internal/explain/prose.go:229
msgid "The whole system ran out of memory at the time."
msgstr "O sistema inteiro estava sem memória naquele momento."

#: internal/explain/prose.go:231
msgid "It hit a memory limit of its control group or slice."
msgstr "Ela bateu em um limite de memória do grupo de controle ou da slice dela."

#: internal/explain/prose.go:233
msgid "A plain restart would most likely end the same way, so none is proposed. Check how much memory it uses and its limits; raise the limit if it is too low, otherwise find out why it needs so much."
msgstr "Uma simples reinicialização provavelmente terminaria do mesmo jeito, então nenhuma é proposta. Veja quanta memória ela usa e quais são os limites dela; aumente o limite se ele for baixo demais, senão descubra por que ela precisa de tanta memória."

#: internal/explain/prose.go:236
#, c-format
msgid "%s crashed."
msgstr "%s travou."

#: internal/explain/prose.go:238
#, c-format
msgid "systemd recorded the result %s."
msgstr "O systemd registrou o resultado %s."

#: internal/explain/prose.go:241
#, c-format
msgid "It had been running for %s and has not crashed like this before."
msgstr "Ela estava rodando havia %s e não tinha travado assim antes."

#: internal/explain/prose.go:243
msgid "A restart is proposed to bring it back, but the crash itself still needs a look."
msgstr "Uma reinicialização é proposta para trazê-la de volta, mas a causa do travamento ainda precisa ser investigada."

#: internal/explain/prose.go:245
#, c-format
msgid "%s keeps crashing."
msgstr "%s trava repetidamente."

#: internal/explain/prose.go:248
#, c-format
msgid "it ended the same way (%s) %s times in the last %s"
msgstr "ela terminou do mesmo jeito (%s) %s vezes nas últimas %s"

#: internal/explain/prose.go:251
#, c-format
msgid "systemd already restarted it %s times"
msgstr "o systemd já a reiniciou %s vezes"

#: internal/explain/prose.go:254
msgid "systemd gave up restarting it after too many failures"
msgstr "o systemd desistiu de reiniciá-la depois de falhas demais"

#: internal/explain/prose.go:257
#, c-format
msgid "it crashed %s after it started"
msgstr "ela travou %s depois de iniciar"

#: internal/explain/prose.go:262
#, c-format
msgid "%s, and %s"
msgstr "%s, e %s"

#: internal/explain/prose.go:266
msgid "A restart would most likely crash the same way, so none is proposed. Look at its log and core dump to find the cause, fix it, then start it again."
msgstr "Uma reinicialização provavelmente travaria do mesmo jeito, então nenhuma é proposta. Veja o log e o core dump dela para achar a causa, corrija e depois inicie de novo."

#: internal/explain/prose.go:269
#, c-format
msgid "%s cannot use a file it needs because of the file permissions."
msgstr "%s não consegue usar um arquivo de que precisa por causa das permissões do arquivo."

#: internal/explain/prose.go:275
#, c-format
msgid "%s has mode %s and belongs to %s, but the service runs as %s, which may not read it."
msgstr "%s tem modo %s e pertence a %s, mas o serviço roda como %s, que talvez não possa lê-lo."

#: internal/explain/prose.go:277
#, c-format
msgid "%s has mode %s and belongs to %s, but the service runs as %s, which may not write it."
msgstr "%s tem modo %s e pertence a %s, mas o serviço roda como %s, que talvez não possa gravar nele."

#: internal/explain/prose.go:279
#, c-format
msgid "%s has mode %s and belongs to %s, but the service runs as %s, which may not search it."
msgstr "%s tem modo %s e pertence a %s, mas o serviço roda como %s, que talvez não possa entrar nele."

#: internal/explain/prose.go:281
#, c-format
msgid "%s has mode %s and belongs to %s, but the service runs as %s, which may not create files in it."
msgstr "%s tem modo %s e pertence a %s, mas o serviço roda como %s, que talvez não possa criar arquivos nele."

#: internal/explain/prose.go:283
#, c-format
msgid "%s has mode %s and belongs to %s, but the service runs as %s, which may not %s it."
msgstr "%s tem modo %s e pertence a %s, mas o serviço roda como %s, que talvez não tenha a permissão %s nele."

#: internal/explain/prose.go:286
msgid "Fix the owner or mode of that path, or the User= and Group= of the unit. Nothing is changed automatically."
msgstr "Corrija o dono ou o modo desse caminho, ou o User= e o Group= da unidade. Nada é alterado automaticamente."

#: internal/explain/prose.go:289
#, c-format
msgid "%s failed, and the assistant could not find out why."
msgstr "%s falhou, e o assistente não conseguiu descobrir por quê."

#: internal/explain/prose.go:291
#, c-format
msgid "The last relevant log line is: %s."
msgstr "A última linha relevante do log é: %s."

#: internal/explain/prose.go:293
msgid "Read the log lines in the evidence below."
msgstr "Leia as linhas de log nas evidências abaixo."

#: internal/explain/prose.go:303 internal/titles/titles.go:119
#, c-format
msgid "%s port %s"
msgstr "porta %s %s"

#: internal/explain/prose.go:314
#, c-format
msgid "%s (labeled %s)"
msgstr "%s (com o rótulo %s)"

#: internal/explain/prose.go:316
#, c-format
msgid "SELinux denied %s the %s permission on %s"
msgstr "O SELinux negou a %s a permissão %s em %s"

#: internal/explain/prose.go:318
#, c-format
msgid "%s, %s times"
msgstr "%s, %s vezes"

#: internal/explain/prose.go:321
#, c-format
msgid "%s; there are %s kinds of denial in all"
msgstr "%s; há %s tipos de negação no total"

#: internal/explain/prose.go:333
#, c-format
msgid "SELinux blocked %s from using %s because it has the wrong label."
msgstr "O SELinux impediu %s de usar %s porque o rótulo está errado."

#: internal/explain/prose.go:336
#, c-format
msgid "The policy default there is %s; the file was probably moved or created with the wrong label."
msgstr "O padrão da política ali é %s; o arquivo provavelmente foi movido ou criado com o rótulo errado."

#: internal/explain/prose.go:339
#, c-format
msgid "SELinux blocked %s from using %s because no rule labels that place for it."
msgstr "O SELinux impediu %s de usar %s porque nenhuma regra rotula esse lugar para ele."

#: internal/explain/prose.go:342
#, c-format
msgid "It is labeled %s, a type %s may not use; %s is a type it may use."
msgstr "Ele tem o rótulo %s, um tipo que %s não pode usar; %s é um tipo que ele pode usar."

#: internal/explain/prose.go:345
#, c-format
msgid "SELinux blocked %s from using %s port %s because the port is not labeled for it."
msgstr "O SELinux impediu %s de usar a porta %s %s porque a porta não tem rótulo para ele."

#: internal/explain/prose.go:348
#, c-format
msgid "The port is labeled %s now."
msgstr "A porta está com o rótulo %s agora."

#: internal/explain/prose.go:352
#, c-format
msgid "SELinux blocked %s because the boolean %s that allows this is off."
msgstr "O SELinux bloqueou %s porque o booleano %s, que permite isso, está desligado."

#: internal/explain/prose.go:355
#, c-format
msgid "SELinux blocked %s because a boolean that would allow this is off."
msgstr "O SELinux bloqueou %s porque um booleano que permitiria isso está desligado."

#: internal/explain/prose.go:358
#, c-format
msgid "SELinux stopped %s from touching %s, which is security sensitive. This looks like the policy doing its job."
msgstr "O SELinux impediu %s de mexer em %s, que é sensível para a segurança. Parece a política fazendo o trabalho dela."

#: internal/explain/prose.go:359
msgid "Do not loosen the policy. Find out why the program tried this."
msgstr "Não afrouxe a política. Descubra por que o programa tentou isso."

#: internal/explain/prose.go:364
msgid "The security rules (SELinux) stopped a program from doing something they do not allow."
msgstr "As regras de segurança (SELinux) impediram um programa de fazer algo que elas não permitem."

#: internal/explain/prose.go:365
msgid "Nothing needs your action now: this is a note for whoever looks after this computer."
msgstr "Nada precisa de ação sua agora: este é um aviso para quem cuida deste computador."

#: internal/explain/prose.go:366
#, c-format
msgid "SELinux blocked %s from using %s, and there is no known safe fix."
msgstr "O SELinux impediu %s de usar %s, e não há correção segura conhecida."

#: internal/explain/prose.go:368
msgid "Please have someone review it before changing the policy. The assistant never writes policy modules on its own."
msgstr "Peça para alguém revisar antes de mudar a política. O assistente nunca escreve módulos de política por conta própria."

#: internal/explain/prose.go:377
msgid "The assistant is not confident enough to propose a change, so it needs a person to review it."
msgstr "O assistente não tem confiança suficiente para propor uma mudança, então uma pessoa precisa revisar."

#: internal/explain/prose.go:388 internal/explain/prose.go:396
#, c-format
msgid "The root file system is %s %% full."
msgstr "O sistema de arquivos raiz está %s %% cheio."

#: internal/explain/prose.go:393
#, c-format
msgid "The root file system is %s %% full, which is critical."
msgstr "O sistema de arquivos raiz está %s %% cheio, o que é crítico."

#: internal/explain/prose.go:401
#, c-format
msgid "Snapshot %s (%s, \"%s\") alone holds %s."
msgstr "Só o snapshot %s (%s, \"%s\") ocupa %s."

#: internal/explain/prose.go:403
#, c-format
msgid "Snapshots hold %s."
msgstr "Os snapshots ocupam %s."

#: internal/explain/prose.go:403
msgid "most of the space"
msgstr "a maior parte do espaço"

#: internal/explain/prose.go:406
#, c-format
msgid "The system journal uses %s."
msgstr "O journal do sistema usa %s."

#: internal/explain/prose.go:408
#, c-format
msgid "Cached packages use %s."
msgstr "Os pacotes em cache usam %s."

#: internal/explain/prose.go:410
msgid "Most of the space is data, not snapshots, logs or cached packages."
msgstr "A maior parte do espaço são dados, não snapshots, logs ou pacotes em cache."

#: internal/explain/prose.go:412
msgid "Nothing is deleted automatically. Look for large files you no longer need."
msgstr "Nada é apagado automaticamente. Procure arquivos grandes de que você não precisa mais."

#: internal/explain/prose.go:414
msgid "Run the disk report as root to measure the space each snapshot holds."
msgstr "Rode o relatório de disco como root para medir o espaço que cada snapshot ocupa."

#: internal/explain/prose.go:419
msgid "At the current rate it will be full within about a day."
msgstr "No ritmo atual, ele vai encher em cerca de um dia."

