#: internal/titles/titles.go:140
msgid "deleted subvolumes cleaned up (space released)"
msgstr "subvolumes apagados foram limpos (espaço liberado)"

#: internal/titles/titles.go:141
#, c-format
msgid "snapshot %s is gone"
msgstr "o snapshot %s não existe mais"

#: internal/titles/titles.go:142
msgid "journal disk usage"
msgstr "uso de disco do journal"

#: internal/titles/titles.go:143
msgid "dnf cache cleaned"
msgstr "cache do dnf limpo"

#: internal/titles/titles.go:144
msgid "the basalt-nonfree repository is on"
msgstr "o repositório basalt-nonfree está ligado"

#: internal/titles/titles.go:145
#, c-format
msgid "%s is installed"
msgstr "%s está instalado"

#: internal/titles/titles.go:146
msgid "nouveau is off from the next start"
msgstr "o nouveau fica desligado a partir da próxima inicialização"

#: internal/titles/titles.go:147
msgid "an installed kernel has the signed NVIDIA module"
msgstr "um kernel instalado tem o módulo NVIDIA assinado"

#: internal/titles/titles.go:148
msgid "the next start is a trial of the NVIDIA driver"
msgstr "a próxima inicialização é um teste do driver NVIDIA"

#: internal/titles/titles.go:149
msgid "the updates wait for the next start"
msgstr "as atualizações aguardam a próxima inicialização"

#: internal/titles/titles.go:150
#, c-format
msgid "the %s updates are installed"
msgstr "as %s atualizações estão instaladas"

#: internal/titles/titles.go:151
#, c-format
msgid "the audit wrote its results (%s)"
msgstr "a auditoria gravou os resultados (%s)"

#: internal/titles/titles.go:152
#, c-format
msgid "the risk of %s is accepted"
msgstr "o risco de %s está aceito"

#: internal/titles/titles.go:153
#, c-format
msgid "the risk of %s is no longer accepted"
msgstr "o risco de %s não está mais aceito"

#: internal/titles/titles.go:154
#, c-format
msgid "the %s channel is on"
msgstr "o canal %s está ligado"

#: internal/titles/titles.go:155
#, c-format
msgid "the %s channel is off"
msgstr "o canal %s está desligado"

#: internal/titles/titles.go:156
#, c-format
msgid "the source %s is recorded with its key"
msgstr "a fonte %s está registrada com a chave dela"

#: internal/titles/titles.go:157
#, c-format
msgid "the system's keyboard is %s, console keymap %s"
msgstr "o teclado do sistema é %s, mapa de teclas do console %s"

#: internal/titles/titles.go:158
#, c-format
msgid "the source %s is gone"
msgstr "a fonte %s não existe mais"

#: internal/titles/titles.go:161
#, c-format
msgid "snapshot %d holds a different copy of %s (%s)"
msgstr "o snapshot %d tem uma cópia diferente de %s (%s)"

#: internal/titles/titles.go:162
#, c-format
msgid "snapshot %d was taken just before the failed transaction \"%s\""
msgstr "o snapshot %d foi tirado logo antes da transação que falhou \"%s\""

#: internal/titles/titles.go:163
msgid "found by the confined daemon, which cannot check the snapshot"
msgstr "encontrada pelo serviço confinado, que não consegue conferir o snapshot"

#: internal/titles/titles.go:164
msgid "proposed through MCP; the confined view cannot check the snapshot"
msgstr "proposta via MCP; a visão confinada não consegue conferir o snapshot"

#: internal/titles/titles.go:165
#, c-format
msgid "proposed by %s before hints existed"
msgstr "proposta por %s antes de as dicas existirem"

#: internal/titles/titles.go:175
#, c-format
msgid "%d updates are ready: %d security, %d Basalt OS components, %d apps, %d system."
msgstr "%d atualizações estão prontas: %d de segurança, %d de componentes do Basalt OS, %d de apps, %d do sistema."

#: internal/titles/titles.go:176
msgid "A snapshot is taken first, so the update can be undone from Settings, Updates and channels, or with sudo basalt updates rollback."
msgstr "Um snapshot é tirado antes, então a atualização pode ser desfeita em Configurações, Atualizações e canais, ou com sudo basalt updates rollback."

#: internal/titles/titles.go:177
#, c-format
msgid "Some of them replace core parts of the system (%s), so they install while the computer restarts, before the desktop starts; a snapshot is taken before and after."
msgstr "Algumas substituem partes centrais do sistema (%s), então elas se instalam enquanto o computador reinicia, antes de a área de trabalho abrir; um snapshot é tirado antes e depois."

#: internal/titles/titles.go:178
#, c-format
msgid "Undo the last update (%s, %d packages, %s): the system goes back to snapshot %d, taken just before it, at the next start."
msgstr "Desfazer a última atualização (%s, %d pacotes, %s): o sistema volta ao snapshot %d, tirado logo antes dela, na próxima inicialização."

#: internal/titles/titles.go:179
msgid "Your files in /home and the other data volumes stay as they are."
msgstr "Seus arquivos em /home e nos outros volumes de dados ficam como estão."

#: internal/titles/titles.go:181
#, c-format
msgid "Turn the %s channel off: no more updates come from it."
msgstr "Desligar o canal %s: não chegam mais atualizações dele."

#: internal/titles/titles.go:182
msgid "What is installed from it stays."
msgstr "O que foi instalado a partir dele fica."

#: internal/titles/titles.go:183
msgid "Turn the basalt-testing channel on: preview builds of Basalt OS components, before they reach everyone."
msgstr "Ligar o canal basalt-testing: versões de prévia dos componentes do Basalt OS, antes de chegarem a todo mundo."

#: internal/titles/titles.go:184
msgid "Turn the basalt-nonfree-testing channel on: preview builds of the additional drivers (the NVIDIA driver), for testers with that hardware."
msgstr "Ligar o canal basalt-nonfree-testing: versões de prévia dos drivers adicionais (o driver NVIDIA), para quem testa com esse hardware."

#: internal/titles/titles.go:185
msgid "Preview builds can break things."
msgstr "Versões de prévia podem quebrar coisas."

#: internal/titles/titles.go:186
msgid "A snapshot is taken before each update so you can go back."
msgstr "Um snapshot é tirado antes de cada atualização para você poder voltar."

#: internal/titles/titles.go:187
#, c-format
msgid "Turn the %s channel on: updates from now on also come from it."
msgstr "Ligar o canal %s: as atualizações daqui em diante também vêm dele."

#: internal/titles/titles.go:188
msgid "Its packages are signed with the OpenBasalt release key."
msgstr "Os pacotes dele são assinados com a chave de release do OpenBasalt."

#: internal/titles/titles.go:189
#, c-format
msgid "Remove %s: no more software comes from it, and its signing key is no longer trusted."
msgstr "Remover %s: não chega mais software dela, e a chave de assinatura dela deixa de ser confiável."

#: internal/titles/titles.go:190
msgid "Programs already installed from it stay; they no longer get updates."
msgstr "Os programas já instalados a partir dela ficam; eles deixam de receber atualizações."

#: internal/titles/titles.go:191
#, c-format
msgid "Add %s."
msgstr "Adicionar %s."

#: internal/titles/titles.go:192
msgid "Software from this source can change your whole system: only add sources you trust."
msgstr "O software desta fonte pode mudar o sistema inteiro: só adicione fontes em que você confia."

#: internal/titles/titles.go:193
#, c-format
msgid "Its signing key, %s, belongs to %s."
msgstr "A chave de assinatura dela, %s, pertence a %s."

#: internal/titles/titles.go:194
#, c-format
msgid "Basalt pins this key for %s."
msgstr "O Basalt fixa esta chave para %s."

#: internal/titles/titles.go:195
msgid "Basalt does not know this source: check the fingerprint with its publisher before you trust it."
msgstr "O Basalt não conhece esta fonte: confira a impressão digital com quem a publica antes de confiar nela."

#: internal/titles/titles.go:196
msgid "Its packages and its package lists are signed."
msgstr "Os pacotes e as listas de pacotes dela são assinados."

#: internal/titles/titles.go:197
msgid "Its packages are signed; its package lists are not (the source does not sign them), so they come from a metalink over HTTPS."
msgstr "Os pacotes dela são assinados; as listas de pacotes não são (a fonte não as assina), então elas vêm de um metalink por HTTPS."

#: internal/titles/titles.go:199
#, c-format
msgid "The login screen, the text console and accounts created from now on type with %s (the first is the default; the console uses the keymap %s)."
msgstr "A tela de login, o console de texto e as contas criadas daqui em diante digitam com %s (o primeiro é o padrão; o console usa o mapa de teclas %s)."

#: internal/titles/titles.go:200
msgid "People who chose their own layouts in Settings, Keyboard keep them."
msgstr "Quem escolheu os próprios layouts em Configurações, Teclado continua com eles."

#: internal/titles/titles.go:201
msgid "To change it again, choose other layouts the same way."
msgstr "Para mudar de novo, escolha outros layouts do mesmo jeito."

#: internal/titles/titles.go:203
msgid "Run the public AI audit suite on this computer: like an attacker would, it tries to get around the protections for AI agents (their confinement, their network limits, the activity record, the confirmation step)."
msgstr "Rodar a suíte pública de auditoria de IA neste computador: como um atacante faria, ela tenta contornar as proteções para agentes de IA (o confinamento, os limites de rede, o registro de atividade, a etapa de confirmação)."

#: internal/titles/titles.go:204
msgid "It runs as its own unprivileged account with fake test data and changes none of your files."
msgstr "Ela roda com uma conta própria sem privilégios, com dados de teste falsos, e não muda nenhum arquivo seu."

#: internal/titles/titles.go:205
msgid "The results appear in Security and Activity."
msgstr "Os resultados aparecem em Segurança e Atividade."

#: internal/titles/titles.go:206
msgid "The suite is not installed yet: it is installed first from the Basalt repositories, checked against their signing key."
msgstr "A suíte ainda não está instalada: ela é instalada primeiro dos repositórios do Basalt, conferida com a chave de assinatura deles."

#: internal/titles/titles.go:207
#, c-format
msgid "Record that %s knows about the warning on %s and accepts it."
msgstr "Registrar que %s sabe do aviso sobre %s e o aceita."

#: internal/titles/titles.go:208
msgid "Security and Activity then shows it as accepted, with the date and who accepted it, and stops counting it."
msgstr "Segurança e Atividade passa a mostrá-lo como aceito, com a data e quem aceitou, e deixa de contá-lo."

#: internal/titles/titles.go:209
msgid "If it ever becomes a problem it shows as a problem again."
msgstr "Se um dia ele virar um problema, volta a aparecer como problema."

#: internal/titles/titles.go:210
msgid "Review again undoes this."
msgstr "Revisar de novo desfaz isto."

#: internal/titles/titles.go:211
#, c-format
msgid "Forget that the risk of %s was accepted: Security and Activity counts it as a warning again."
msgstr "Esquecer que o risco de %s foi aceito: Segurança e Atividade volta a contá-lo como aviso."

#: internal/titles/titles.go:213
#, c-format
msgid "Proposed by an MCP client: %s"
msgstr "Proposta por um cliente MCP: %s"

#: internal/titles/titles.go:214
#, c-format
msgid "Confirmed as root: %s."
msgstr "Confirmado como root: %s."

#: internal/titles/titles.go:216
#, c-format
msgid "Applying %s stopped before it was done."
msgstr "Aplicar %s parou antes de terminar."

#: internal/titles/titles.go:217
#, c-format
msgid "Applying %s stopped before it was done, and its log does not say why."
msgstr "Aplicar %s parou antes de terminar, e o log não diz por quê."

#: internal/titles/titles.go:218
#, c-format
msgid "The log says: %s."
msgstr "O log diz: %s."

#: internal/titles/titles.go:219
#, c-format
msgid "The change itself (%s) still waits for you: open it to try again, or dismiss it."
msgstr "A mudança em si (%s) continua esperando por você: abra para tentar de novo, ou descarte."

#: internal/titles/titles.go:220
msgid "Nothing will be changed by this report."
msgstr "Nada será alterado por este relatório."
