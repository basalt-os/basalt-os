# Basalt OS package repository: only the packages that make Basalt OS
# different (release files, branding, snapshots, later tools and the
# assistant). Everything else comes from the Fedora repositories.
# Packages and repository metadata are both signature checked.
# The base URL comes from /etc/dnf/vars/basalt_repo_url.
[basalt]
name=Basalt OS $releasever - $basearch
baseurl=$basalt_repo_url/$releasever/$basearch/
enabled=1
gpgcheck=1
repo_gpgcheck=1
gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-basalt
metadata_expire=6h
