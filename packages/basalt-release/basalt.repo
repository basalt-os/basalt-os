# Basalt OS package repositories: only the packages that make Basalt OS
# different (release files, branding, snapshots, the assistant, later
# tools). Everything else comes from the Fedora repositories. Packages and
# repository metadata are both signature checked with the OpenBasalt
# release key.
# Base URLs come from /etc/dnf/vars/basalt_repo_url and basalt_testing_url
# (default https://obpkg.org/basalt and https://obpkg.org/basalt-testing);
# point them at a mirror or a lab repository to override.
[basalt]
name=Basalt OS $releasever - $basearch
baseurl=$basalt_repo_url/$releasever/$basearch/
enabled=1
gpgcheck=1
repo_gpgcheck=1
gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-basalt
metadata_expire=6h

# Packages on their way to [basalt]. Off by default; enable with
# dnf config-manager setopt basalt-testing.enabled=1
[basalt-testing]
name=Basalt OS testing $releasever - $basearch
baseurl=$basalt_testing_url/$releasever/$basearch/
enabled=0
gpgcheck=1
repo_gpgcheck=1
gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-basalt
skip_if_unavailable=True
metadata_expire=6h
