# Basalt OS defaults. Read before 90-default.preset, so these win.

# Host firewall, SSH and audit are always on for a server.
enable firewalld.service
enable sshd.service
enable auditd.service
enable audit-rules.service

# Snapshots (basalt-snapshots): daily cleanup by the retention policy and the
# boot menu entries for snapshots. No hourly timeline snapshots of the root.
enable snapper-cleanup.timer
disable snapper-timeline.timer
enable basalt-snapshot-boot.service
enable basalt-initial-snapshot.service
# Sets snapshots up at boot when a system has none yet (Basalt packages
# added to an installed Fedora); nothing to do on a Basalt OS install.
enable basalt-snapshots-auto.service

# Security (basalt-security): Basalt module signing certificates loaded at
# boot. basalt-tpm-resume.service is enabled only by `basalt-tpm suspend`.
enable basalt-module-keys.service
disable basalt-tpm-resume.service

# System assistant (basalt-assistant): the confined event engine (it only
# proposes), its notifications and the sealed rotation of its audit log.
# The local model service (basalt-llm) is optional and stays off.
enable basalt-assistantd.service
enable basalt-notify.service
enable basalt-audit-rotate.timer

# Per-session default-deny egress for confined sessions (basalt-resolver)
# and the system audit trail (basalt-ledger), installed by default.
enable basalt-resolver.service
enable basalt-ledger.service

# Branding: keep the GRUB theme on /boot in sync with the package.
enable basalt-grub-theme.service

# Not wanted on a minimal server.
disable ModemManager.service
disable bluetooth.*
disable avahi-daemon.*
disable cups.*
