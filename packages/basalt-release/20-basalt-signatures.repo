# Signature checks of the Basalt OS repositories, enforced by basalt-release.
#
# dnf reads this file after the repository definitions in /etc/yum.repos.d
# (vendor overrides, /usr/share/dnf5/repos.override.d), so these settings
# hold even when /etc/yum.repos.d/basalt.repo is an older or hand-written
# file: that file is a configuration file an upgrade never replaces, and a
# copy without repo_gpgcheck=1 would otherwise stay in effect. Base URLs,
# enabled and the other options still come from the repository files and
# /etc/dnf/vars.
#
# Do not edit: an upgrade replaces this file. An administrator who really
# wants other signature settings writes them under /etc/dnf/repos.override.d
# (a file of the same name there replaces this one); `basalt channels`
# shows the settings in effect.
[basalt]
gpgcheck=1
repo_gpgcheck=1
gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-basalt

[basalt-tools]
gpgcheck=1
repo_gpgcheck=1
gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-basalt

[basalt-testing]
gpgcheck=1
repo_gpgcheck=1
gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-basalt
