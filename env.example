# Copy to .env (gitignored) and adjust. Every script and make target reads it.
# Shell syntax: quote values that contain spaces; ${VAR} references expand.
# Placeholder values only: real addresses, users and paths stay in .env.

# Base image. Pin the Fedora release explicitly; "latest" moves without notice.
BASE_IMAGE=quay.io/fedora/fedora-bootc:44

# The image version comes from the VERSION file; override for one run with
# `make build BASALT_VERSION=x.y.z`.

# Where images are published. Any OCI registry works (a lab registry, ghcr.io, quay.io).
REGISTRY=registry.example.lan:5000
IMAGE_REPO=basalt/basalt-os
# Moving tag that installed systems follow for updates.
CHANNEL_TAG=stable

# Container engine used for builds. bootc-image-builder needs rootful podman.
PODMAN="sudo podman"

# Lab state directory on the build host: registry data, lab CA, dev signing key,
# VM disks. Must not be inside this repository.
LAB_DIR=/srv/basalt-lab

# Directory for VM disk images. It must be readable by the hypervisor (qemu user).
VM_DIR=/var/lib/libvirt/images/basalt-lab

# Local lab registry (scripts/lab/registry.sh).
REGISTRY_BIND=192.0.2.10
REGISTRY_PORT=5000
REGISTRY_HOSTNAMES=registry.example.lan
REGISTRY_USER=basalt-lab
REGISTRY_CONTAINER=basalt-lab-registry

# Signing for the lab registry: a cosign key pair generated by `make lab-keys`.
# Leave empty to build an image that ships no signature policy.
SIGNING_PUBKEY=${LAB_DIR}/keys/cosign.pub

# Lab VM (scripts/lab/vm.sh).
VM_NAME=basalt-lab-vm
VM_NETWORK=basalt-lab
VM_SUBNET=10.150.0
# MAC of the VM; the network gives it the fixed address ${VM_SUBNET}.10.
VM_MAC=52:54:00:15:00:10
# Linux bridge name for the lab network (max 15 characters).
VM_BRIDGE=bsltlab0
VM_MEMORY_MB=4096
VM_VCPUS=2
VM_DISK_GB=20
# Public key injected for root SSH access on installed lab systems.
SSH_PUBKEY_FILE=${LAB_DIR}/keys/authorized_keys
# Extra public keys (space separated files) added to that authorized_keys by `make lab-keys`.
EXTRA_SSH_PUBKEYS=
