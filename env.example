# Copy to .env (gitignored) and adjust. Every script and make target reads it.
# Shell syntax: quote values that contain spaces; ${VAR} references expand.
# Placeholder values only: real addresses, users and paths stay in .env.

# Fedora release the packages and the ISO are built for.
FEDORA_RELEASE=44

# Container engine for builds. mkksiso needs root, so rootful podman.
PODMAN="sudo podman"

# Lab state on the build host: signing key, SSH key, site files, recovery
# keys, logs. Must not be inside this repository.
LAB_DIR=/srv/basalt-lab

# Build outputs (RPMs, ISO, Fedora ISO cache). Default: ./build.
#BUILD_DIR=/srv/basalt-lab/build

# Signed RPM repository tree that the lab HTTP server publishes.
REPO_DIR=/srv/basalt-lab/repo

# Development repository key: generated by `make lab-keys`, embedded in
# basalt-release by `make rpms`. Leave empty to build with the placeholder.
GNUPGHOME_LAB=/srv/basalt-lab/gpg
BASALT_GPG_PUBKEY=/srv/basalt-lab/gpg/RPM-GPG-KEY-basalt-lab

# Lab network (scripts/lab/vm.sh). VMs get ${VM_SUBNET}.10, .11 and so on.
VM_NETWORK=basalt-lab
VM_SUBNET=10.150.0
VM_BRIDGE=bsltlab0
VM_MAC_PREFIX=52:54:00:15:00
VM_NAME=basalt-lab-vm1
VM_MEMORY_MB=8192
VM_VCPUS=4
VM_DISK_GB=30
# Directory for VM disk images; it must be readable by the qemu user.
VM_DIR=/var/lib/libvirt/images/basalt-lab

# Repository HTTP server for lab VMs (scripts/lab/repo-serve.sh), bound to
# the lab network's gateway address.
REPO_PORT=8098
REPO_CONTAINER=basalt-lab-repo
LAB_REPO_URL=http://10.150.0.1:8098

# Extra public keys (space separated files) authorized for root on lab VMs.
EXTRA_SSH_PUBKEYS=

# Installer ISO built for the lab: site files from `make lab-keys`.
SITE_DIR=/srv/basalt-lab/site
SITE_NAME=lab
